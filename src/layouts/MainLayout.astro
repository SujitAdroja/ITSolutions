---
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Shahastra Solutions' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="antialiased bg-white text-gray-900">
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script type="module">
  import Alpine from 'https://cdn.jsdelivr.net/npm/alpinejs@3.12.0/dist/module.esm.js';
  window.Alpine = Alpine;
  Alpine.start();

  document.addEventListener("alpine:init", () => {
    Alpine.data("testimonialSlider", () => ({
      current: 0,
      total: 4,

      init() {
        setInterval(() => {
          this.next();
        }, 5000);
      },

      next() {
        if (this.current >= this.total - 2) {
          this.current = 0;
        } else {
          this.current++;
        }
      },

      prev() {
        if (this.current <= 0) {
          this.current = this.total - 2;
        } else {
          this.current--;
        }
      },
    }));
  });
</script>