---
import HeroSection from "../components/about/HeroSection.astro";
import StatsSection from "../components/about/StatsSection.astro";
import PeopleLoveUsSection from "../components/about/PeopleLoveUsSection.astro";
import HowItWorksSection from "../components/about/HowItWorksSection.astro";
import MainLayout from "../layouts/MainLayout.astro";
import TestimonialsSection from "../components/home/TestimonialsSection.astro";
---

<MainLayout
  title="About Us | UK Staff Augmentation & Quick-Delivery IT Company — EchoEleganceLtd.uk"
  description="Meet EchoEleganceLtd.uk — a London-based IT company trusted across the UK for staff augmentation, fast software delivery, digital marketing and accounting. 50+ developers delivered, 20+ technologies, 100% client satisfaction."
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'About Us', href: '/about-us' }]}
>

  <section class="page-hero">
    <div class="container-x py-14 md:py-20">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">›</span>
        <span>About Us</span>
      </nav>
      <h1 class="h-display">About <span class="text-gradient">Us</span></h1>
      <p class="lead mt-5 max-w-xl">
        A service-focused company helping businesses improve operations, strengthen digital presence, and deliver better customer experiences.
      </p>
    </div>
  </section>

  <HeroSection />
  <StatsSection />
  <PeopleLoveUsSection />
  <HowItWorksSection />
  <TestimonialsSection />
</MainLayout>
