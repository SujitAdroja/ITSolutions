---
import HeroSection from "../components/about/HeroSection.astro";
import StatsSection from "../components/about/StatsSection.astro";
import PeopleLoveUsSection from "../components/about/PeopleLoveUsSection.astro";
import HowItWorksSection from "../components/about/HowItWorksSection.astro";
import MainLayout from "../layouts/MainLayout.astro";
import TestimonialsSection from "../components/home/TestimonialsSection.astro";
---

<MainLayout title="About Us — EchoEleganceLTD">

  <!-- Page Hero -->
  <section style="background-color: #f4f4f5; padding: 64px 0 48px;">
    <div class="max-w-[1200px] mx-auto px-6 lg:px-8">
      <p class="text-xs md:text-sm" style="font-weight: 400; color: #a1a1aa; margin-bottom: 12px;">
        <a href="/" style="color: #a1a1aa; text-decoration: none;">Home</a>
        <span style="margin: 0 6px;">›</span>
        <span style="color: #09090b;">About Us</span>
      </p>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold" style="color: #09090b; line-height: 1.12;">
        About <span style="color: #2563eb;">Us</span>
      </h1>
      <p class="text-sm md:text-base" style="font-weight: 400; color: #71717a; line-height: 1.5; margin-top: 16px; max-width: 520px;">
        A service-focused company helping businesses improve operations, strengthen digital presence, and deliver better customer experiences.
      </p>

    </div>
  </section>

  <section class="page-section">
    <HeroSection />
    <StatsSection />
    <PeopleLoveUsSection />
    <HowItWorksSection />
    <TestimonialsSection />
  </section>
</MainLayout>
