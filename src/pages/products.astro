---
import MainLayout from "../layouts/MainLayout.astro";

export const products = [
  {
    title: "Sales Force Automation (SFA)",
    badge: "Demo Ready",
    badgeType: "demo",
    image: "/products/salseforce.webp",
    description:
      "For Company or Distributor to track activities of every salesperson in market and convert their hours into productivity, capturing more orders from market.",
    features: [
      "Monitor Sales Staff's activity real-time",
      "Online Ordering Process",
      "Track Location of your Sales Person",
      "Collect Information from the market",
      "Track your salesperson's productivity",
    ],
  },
  {
    title: "Distribution Manage System (DMS)",
    badge: "Demo Ready",
    badgeType: "demo",
    image: "/products/DMS.webp",
    description:
      "For Company or Distributor to track their customers sales, purchase data, stock, outstanding payment and expenses.",
    features: [
      "Distributor or Dealer's Sales",
      "Central Monitoring of all orders",
      "Supports Ready Stock and Order Booking",
      "Scheme and Claim Management",
      "Integrated SFA application",
    ],
  },
  {
    title: "Sale Marketing Strategies (Machine Learning)",
    badge: "Work Upgrade",
    badgeType: "upgrade",
    image: "/products/sales-marketing.jpg",
    description:
      "Recognition of patterns in data and helpful for forecasting consumer purchases.",
    features: [
      "Demand Forecasting",
      "Product Seasonal Promotion Scheme",
      "Company Purchases Forecasting",
      "Churn Price",
      "Stock Forecasting",
    ],
  },
  {
    title: "Point of Sale (POS)",
    badge: "Work Upgrade",
    badgeType: "upgrade",
    image: "/products/POS.png",
    description:
      "Online and offline solutions for distribution store and mobile store management.",
    features: [
      "Desktop to Manage Everything",
      "Inventory Management Module",
      "Payment Module",
      "Day Close Module",
      "Customer Special Scheme and Claim",
    ],
  },
  {
    title: "E-Commerce Application",
    badge: "Demo Ready",
    badgeType: "demo",
    image: "/products/ecommerce.webp",
    description:
      "Reach worldwide markets through our fully-featured E-Commerce application built for scale.",
    features: [
      "Coupon & Scheme Module",
      "Admin & Seller Portal",
      "Google SEO Friendly URL",
      "Courier & Email & SMS & Payment",
      "Stock Management with Inventory App",
    ],
  },
  {
    title: "Accounting Software",
    badge: "Work Upgrade",
    badgeType: "upgrade",
    image: "/products/accounting-software.png",
    description:
      "Company-level entries for Sales, Purchase, Stock, and On Account Payment with full reporting.",
    features: [
      "Sales order & Purchase order Module",
      "Inventory Management Module",
      "Finance Module",
      "Payment Module",
      "Customize to support your business",
    ],
  },
];
---

<MainLayout
  title="Products | SFA, DMS, POS, E-Commerce & Accounting Software UK — EchoEleganceLtd.uk"
  description="Ready-to-deploy business software from a UK quick-delivery IT company: Sales Force Automation, Distribution Management, POS, E-Commerce and Accounting software — demo ready and customisable."
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Products', href: '/products' }]}
>

  <section class="page-hero">
    <div class="container-x py-14 md:py-20">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">›</span>
        <span>Products</span>
      </nav>
      <h1 class="h-display">Our <span class="text-gradient">Products</span></h1>
      <p class="lead mt-5 max-w-xl">
        Purpose-built software tools that help businesses track, manage, and grow across every operational layer.
      </p>
    </div>
  </section>

  <section class="section bg-bg-alt">
    <div class="container-x">
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3">
        {products.map((product) => (
          <article class="card card-hover reveal group flex flex-col overflow-hidden">
            <div class="relative overflow-hidden">
              <img
                src={product.image}
                alt={product.title}
                class="h-52 w-full object-cover transition duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-t from-navy/60 to-transparent"></div>
              <span
                class:list={[
                  'absolute bottom-3.5 left-3.5 inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold backdrop-blur',
                  product.badgeType === 'demo'
                    ? 'bg-emerald-500/90 text-white'
                    : 'bg-white/90 text-navy',
                ]}
              >
                <span class:list={['size-1.5 rounded-full', product.badgeType === 'demo' ? 'bg-white' : 'bg-brand']}></span>
                {product.badge}
              </span>
            </div>

            <div class="flex flex-1 flex-col gap-3 p-6 md:p-7">
              <h3 class="text-xl font-semibold leading-snug text-fg">{product.title}</h3>
              <p class="text-sm leading-relaxed text-muted md:text-[15px]">{product.description}</p>
              <ul class="mt-1 flex flex-col gap-2">
                {product.features.map((feature) => (
                  <li class="flex items-start gap-2.5 text-sm text-fg-2">
                    <svg class="mt-0.5 shrink-0 text-brand" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

</MainLayout>
