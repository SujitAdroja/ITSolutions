---
import MainLayout from "../layouts/MainLayout.astro";

export const products = [
  {
    title: "Sales Force Automation (SFA)",
    badge: "Demo Ready",
    badgeType: "demo",
    image: "/products/salseforce.webp",
    description:
      "For Company or Distributor to track activities of every salesperson in market and convert their hours into productivity, capturing more orders from market.",
    features: [
      "Monitor Sales Staff's activity real-time",
      "Online Ordering Process",
      "Track Location of your Sales Person",
      "Collect Information from the market",
      "Track your salesperson's productivity",
    ],
  },
  {
    title: "Distribution Manage System (DMS)",
    badge: "Demo Ready",
    badgeType: "demo",
    image: "/products/DMS.webp",
    description:
      "For Company or Distributor to track their customers sales, purchase data, stock, outstanding payment and expenses.",
    features: [
      "Distributor or Dealer's Sales",
      "Central Monitoring of all orders",
      "Supports Ready Stock and Order Booking",
      "Scheme and Claim Management",
      "Integrated SFA application",
    ],
  },
  {
    title: "Sale Marketing Strategies (Machine Learning)",
    badge: "Work Upgrade",
    badgeType: "upgrade",
    image: "/products/sales-marketing.jpg",
    description:
      "Recognition of patterns in data and helpful for forecasting consumer purchases.",
    features: [
      "Demand Forecasting",
      "Product Seasonal Promotion Scheme",
      "Company Purchases Forecasting",
      "Churn Price",
      "Stock Forecasting",
    ],
  },
  {
    title: "Point of Sale (POS)",
    badge: "Work Upgrade",
    badgeType: "upgrade",
    image: "/products/POS.png",
    description:
      "Online and offline solutions for distribution store and mobile store management.",
    features: [
      "Desktop to Manage Everything",
      "Inventory Management Module",
      "Payment Module",
      "Day Close Module",
      "Customer Special Scheme and Claim",
    ],
  },
  {
    title: "E-Commerce Application",
    badge: "Demo Ready",
    badgeType: "demo",
    image: "/products/ecommerce.webp",
    description:
      "Reach worldwide markets through our fully-featured E-Commerce application built for scale.",
    features: [
      "Coupon & Scheme Module",
      "Admin & Seller Portal",
      "Google SEO Friendly URL",
      "Courier & Email & SMS & Payment",
      "Stock Management with Inventory App",
    ],
  },
  {
    title: "Accounting Software",
    badge: "Work Upgrade",
    badgeType: "upgrade",
    image: "/products/accounting-software.png",
    description:
      "Company-level entries for Sales, Purchase, Stock, and On Account Payment with full reporting.",
    features: [
      "Sales order & Purchase order Module",
      "Inventory Management Module",
      "Finance Module",
      "Payment Module",
      "Customize to support your business",
    ],
  },
];
---

<MainLayout title="Products — EchoEleganceLTD">

  <!-- Page Hero -->
  <section style="background-color: #f4f4f5; padding: 64px 0 48px;">
    <div class="max-w-[1200px] mx-auto px-6 lg:px-8">
      <p style="font-size: 13px; font-weight: 400; color: #a1a1aa; margin-bottom: 12px;">
        <a href="/" style="color: #a1a1aa; text-decoration: none;">Home</a>
        <span style="margin: 0 6px;">›</span>
        <span style="color: #09090b;">Products</span>
      </p>
      <h1 style="font-size: 56px; font-weight: 700; color: #09090b; line-height: 1.12;">
        Our <span style="color: #a1a1aa;">Products</span>
      </h1>
      <p style="font-size: 16px; font-weight: 400; color: #71717a; line-height: 1.5; margin-top: 16px; max-width: 520px;">
        Purpose-built software tools that help businesses track, manage, and grow across every operational layer.
      </p>
    </div>
  </section>

  <!-- Products Grid -->
  <section style="background-color: #f4f4f5; padding: 0 0 80px;">
    <div class="max-w-[1200px] mx-auto px-6 lg:px-8">

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
        {products.map((product) => (
          <article
            class="reveal product-card"
            style="background-color: #ffffff; border-radius: 36px; border: 1px solid #ececee; box-shadow: rgb(228,228,231) 0px 1px 0px 0px inset; overflow: hidden; display: flex; flex-direction: column;"
          >
            <!-- Image tile with overlay badge -->
            <div style="position: relative; overflow: hidden; border-radius: 36px 36px 0 0;">
              <img
                src={product.image}
                alt={product.title}
                style="width: 100%; height: 220px; object-fit: cover; display: block;"
              />
              <!-- Dark overlay badge -->
              <div style="position: absolute; bottom: 14px; left: 14px;">
                <span style={`
                  background: transparent;
                  color: #ffffff;
                  border: 1px solid ${product.badgeType === 'demo' ? 'rgba(255,255,255,0.5)' : 'rgba(255,255,255,0.35)'};
                  border-radius: 12px;
                  padding: 4px 10px;
                  font-size: 12px;
                  font-weight: 500;
                  backdrop-filter: blur(8px);
                `}>
                  {product.badge}
                </span>
              </div>
            </div>

            <!-- Content -->
            <div style="padding: 24px 28px 28px; display: flex; flex-direction: column; gap: 12px; flex: 1;">
              <h3 style="font-size: 20px; font-weight: 600; color: #09090b; line-height: 1.35;">
                {product.title}
              </h3>

              <p style="font-size: 14px; font-weight: 400; color: #71717a; line-height: 1.56;">
                {product.description}
              </p>

              <!-- Feature list -->
              <ul style="display: flex; flex-direction: column; gap: 8px; margin-top: 4px;">
                {product.features.map((feature) => (
                  <li style="display: flex; align-items: flex-start; gap: 10px;">
                    <div style="width: 6px; height: 6px; border-radius: 50%; background-color: #3f3f46; margin-top: 6px; flex-shrink: 0;"></div>
                    <span style="font-size: 14px; font-weight: 400; color: #52525b; line-height: 1.56;">{feature}</span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

</MainLayout>

<style>
  .product-card {
    transition: transform 0.25s ease;
  }
  .product-card:hover {
    transform: translateY(-6px);
  }
</style>
