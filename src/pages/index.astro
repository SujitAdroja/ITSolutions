---
import { getImage } from 'astro:assets';
import MainLayout from '../layouts/MainLayout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import FeaturesSection from '../components/home/FeaturesSection.astro';
import WhyChooseSection from '../components/home/WhyChooseSection.astro';
import StatsSection from '../components/home/StatsSection.astro';
import ApplicationAreasSection from '../components/home/ApplicationAreasSection.astro';
import TestimonialsSection from '../components/home/TestimonialsSection.astro';
import ContactSection from '../components/home/ContactSection.astro';
import { heroImage, heroWidths, heroSizes } from '../components/home/heroImage';

// Preload the LCP image so it starts downloading before the parser reaches the hero
const heroPreload = await getImage({ src: heroImage, format: 'avif', widths: heroWidths, sizes: heroSizes });
---

<MainLayout
  title="Best Staff Augmentation Company in UK | Quick-Delivery IT Solutions — EchoEleganceLtd.uk"
  description="EchoEleganceLtd.uk is the UK's best staff augmentation company and quick-delivery IT partner. Hire vetted React, Angular, Node.js, Flutter & AWS developers within days — 50+ developers delivered, 20+ technologies, 100% satisfaction. London based, serving all of the UK."
>
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/avif"
    href={heroPreload.src}
    imagesrcset={heroPreload.srcSet.attribute}
    imagesizes={heroSizes}
    fetchpriority="high"
  />
  <HeroSection />
  <FeaturesSection />
  <WhyChooseSection />
  <StatsSection />
  <ApplicationAreasSection />
  <TestimonialsSection />
  <ContactSection />
</MainLayout>


