---
import ContactCard from "../components/contact/ContactCard.astro";
import GetInTouchSection from "../components/contact/GetInTouchSection.astro";
import OfficeMapSeaction from "../components/contact/OfficeMapSeaction.astro";
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Contact Us | Hire Developers in the UK Within Days — EchoEleganceLtd.uk"
  description="Contact EchoEleganceLtd.uk, London — the UK's quick-delivery IT and staff augmentation company. Get shortlisted developer profiles within days or a project quote within 24 hours. Wembley, London HA0 1TX."
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Contact Us', href: '/contact-us' }]}
>

  <section class="page-hero">
    <div class="container-x py-14 md:py-20">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">›</span>
        <span>Contact Us</span>
      </nav>
      <h1 class="h-display">Contact <span class="text-gradient">Us</span></h1>
      <p class="lead mt-5 max-w-xl">
        Reach out for project enquiries, service support, or partnerships — our team will respond with the right next step.
      </p>
    </div>
  </section>

  <ContactCard />
  <GetInTouchSection />
  <OfficeMapSeaction />

</MainLayout>
