---
import ContactCard from "../components/contact/ContactCard.astro";
import GetInTouchSection from "../components/contact/GetInTouchSection.astro";
import OfficeMapSeaction from "../components/contact/OfficeMapSeaction.astro";
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Contact Us — EchoEleganceLTD">

  <!-- Page Hero -->
  <section style="background-color: #f4f4f5; padding: 64px 0 48px;">
    <div class="max-w-[1200px] mx-auto px-6 lg:px-8">
      <p class="text-xs md:text-sm" style="font-weight: 400; color: #a1a1aa; margin-bottom: 12px;">
        <a href="/" style="color: #a1a1aa; text-decoration: none;">Home</a>
        <span style="margin: 0 6px;">›</span>
        <span style="color: #09090b;">Contact Us</span>
      </p>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold" style="color: #09090b; line-height: 1.12;">
        Contact <span style="color: #2563eb;">Us</span>
      </h1>
      <p class="text-sm md:text-base" style="font-weight: 400; color: #71717a; line-height: 1.5; margin-top: 16px; max-width: 520px;">
        Reach out for project enquiries, service support, or partnerships — our team will respond with the right next step.
      </p>
    </div>
  </section>

  <ContactCard />
  <GetInTouchSection />
  <OfficeMapSeaction />

</MainLayout>
