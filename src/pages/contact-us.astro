---
import ContactCard from "../components/contact/ContactCard.astro";
import GetInTouchSection from "../components/contact/GetInTouchSection.astro";
import OfficeMapSeaction from "../components/contact/OfficeMapSeaction.astro";
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Contact Us">
  <section class="relative overflow-hidden">
    <img
      src="/homepage/page-title-bg.jpg"
      alt="Background Image"
      class="absolute w-full -z-1 h-70 object-cover scale-190 object-[20%_10%]"
    />
    <div class="relative z-10 max-w-[1400px] mx-auto px-6 py-20">
      <h2 class="text-center text-black text-5xl font-bold mb-4">Contact Us</h2>
      <div class="text-center">
        <span class="text-gray-500 hover:text-orange-500"><a href="/">Home</a></span><span
          class="text-orange-500"
        >
          >
        </span>
        <span>Contact Us</span>
      </div>
    </div>
  </section>
  <div class="relative max-w-[1400px] mx-auto px-6 py-10">
    <ContactCard />
    <GetInTouchSection />
    <OfficeMapSeaction />
  </div>
</MainLayout>
