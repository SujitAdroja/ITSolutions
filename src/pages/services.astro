---
import MainLayout from "../layouts/MainLayout.astro";
import { Rocket, Laptop, Headset, PlugZap, BarChart3, CloudCog } from "lucide-react";

const modules = [
  {
    title: "Workflow Automation",
    icon: Rocket,
    description: "Streamline routine operations with structured processes that improve speed, consistency, and control across your team.",
  },
  {
    title: "Responsive Experience",
    icon: Laptop,
    description: "Deliver a clean and accessible experience across desktop, tablet, and mobile without compromising usability.",
  },
  {
    title: "Reliable Support",
    icon: Headset,
    description: "Keep operations moving with responsive assistance, issue resolution, and ongoing service support when you need it.",
  },
  {
    title: "System Integration",
    icon: PlugZap,
    description: "Connect core business tools, data sources, and external platforms to reduce duplication and improve accuracy.",
  },
  {
    title: "Reporting & Insights",
    icon: BarChart3,
    description: "Access meaningful reports and dashboards that help teams monitor performance and make better decisions.",
  },
  {
    title: "Scalable Delivery",
    icon: CloudCog,
    description: "Build solutions that can grow with your business, supporting new requirements without disrupting existing operations.",
  },
];

export const services = [
  {
    title: "Digital Marketing",
    icon: "/services/marketing-seo.png",
    items: ["Brand Strategy", "Campaign Planning", "Audience Targeting", "Performance Tracking"],
  },
  {
    title: "Accounting",
    icon: "/services/analytical-report.png",
    items: ["Bookkeeping Support", "Financial Reporting", "Reconciliation", "Compliance Tracking"],
  },
  {
    title: "Web Development",
    icon: "/services/webcloud.png",
    items: ["Business Websites", "Web Applications", "CMS Solutions", "API Integration"],
  },
  {
    title: "Web Designing",
    icon: "/services/web-designing.png",
    items: ["Responsive Layouts", "UI / UX Design", "Landing Pages", "Brand Visuals"],
  },
  {
    title: "Graphics Designing",
    icon: "/services/graphic-designing.png",
    items: ["Logo Design", "Social Media Creatives", "Marketing Collateral", "Brand Identity Assets"],
  },
  {
    title: "Marketing & SEO",
    icon: "/services/marketing-seo.png",
    items: ["Search Visibility", "Content Optimization", "Keyword Strategy", "Lead Generation"],
  },
  {
    title: "Analytical Reports",
    icon: "/services/analytical-report.png",
    items: ["MIS Dashboards", "KPI Monitoring", "Tabular Reports", "Trend Analysis"],
  },
  {
    title: "Custom Development",
    icon: "/services/custome-development.png",
    items: ["Tailored Features", "Business Automation", "Workflow Tools", "Process Modules"],
  },
  {
    title: "Service Administrations",
    icon: "/services/server-administration.png",
    items: ["User Management", "Access Controls", "Service Monitoring", "Administrative Support"],
  },
  {
    title: "QA & QC",
    icon: "/services/QA-EC.png",
    items: ["Quality Checks", "Test Planning", "Validation", "Issue Review"],
  },
  {
    title: "Marketing Consultancy",
    icon: "/services/marketing-seo.png",
    items: ["Growth Planning", "Brand Positioning", "Channel Strategy", "Campaign Review"],
  },
  {
    title: "Software Support",
    icon: "/services/custome-development.png",
    items: ["Feature Updates", "Bug Fixing", "System Maintenance", "Release Support"],
  },
];
---

<MainLayout title="Services — EchoEleganceLTD">

  <!-- Page Hero -->
  <section style="background-color: #f4f4f5; padding: 64px 0 48px;">
    <div class="max-w-[1200px] mx-auto px-6 lg:px-8">
      <p style="font-size: 13px; font-weight: 400; color: #a1a1aa; margin-bottom: 12px;">
        <a href="/" style="color: #a1a1aa; text-decoration: none;">Home</a>
        <span style="margin: 0 6px;">›</span>
        <span style="color: #09090b;">Services</span>
      </p>
      <h1 style="font-size: 56px; font-weight: 700; color: #09090b; line-height: 1.12;">
        Our <span style="color: #a1a1aa;">Services</span>
      </h1>
      <p style="font-size: 16px; font-weight: 400; color: #71717a; line-height: 1.5; margin-top: 16px; max-width: 520px;">
        A coordinated set of services — accounting, marketing, and software development — built to support how businesses actually operate.
      </p>
    </div>
  </section>

  <!-- Services Grid -->
  <section style="background-color: #f4f4f5; padding: 0 0 80px;">
    <div class="max-w-[1200px] mx-auto px-6 lg:px-8">

      <div class="text-center reveal" style="margin-bottom: 48px;">
        <h2 style="font-size: 40px; font-weight: 700; color: #09090b; line-height: 1.25;">
          Services We Can <span style="color: #a1a1aa;">Help You With</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
        {services.map((service) => (
          <article class="reveal service-card" style="background-color: #ffffff; border-radius: 36px; border: 1px solid #ececee; box-shadow: rgb(228,228,231) 0px 1px 0px 0px inset; padding: 28px; display: flex; flex-direction: column; gap: 16px;">

            <!-- Icon -->
            <div style="width: 48px; height: 48px; border-radius: 40px; background-color: #f4f4f5; display: flex; align-items: center; justify-content: center;">
              <img src={service.icon} alt={service.title} style="width: 28px; height: 28px; object-fit: contain;" />
            </div>

            <!-- Title -->
            <h3 style="font-size: 20px; font-weight: 600; color: #09090b; line-height: 1.35;">
              {service.title}
            </h3>

            <!-- Feature list -->
            <ul style="display: flex; flex-direction: column; gap: 8px;">
              {service.items.map((item) => (
                <li style="display: flex; align-items: flex-start; gap: 10px;">
                  <div style="width: 6px; height: 6px; border-radius: 50%; background-color: #3f3f46; margin-top: 6px; flex-shrink: 0;"></div>
                  <span style="font-size: 14px; font-weight: 400; color: #52525b; line-height: 1.56;">{item}</span>
                </li>
              ))}
            </ul>

          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Generic Modules -->
  <section style="background-color: #ffffff; padding: 80px 0;">
    <div class="max-w-[1200px] mx-auto px-6 lg:px-8">

      <div class="text-center reveal" style="margin-bottom: 48px;">
        <span style="background-color: #3f3f46; color: #fafafa; border-radius: 12px; padding: 4px 10px; font-size: 12px; font-weight: 500; display: inline-block; margin-bottom: 16px;">
          Our Solutions
        </span>
        <h2 style="font-size: 40px; font-weight: 700; color: #09090b; line-height: 1.25;">
          Generic Modules That <span style="color: #a1a1aa;">Support Every Service</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
        {modules.map((item) => {
          const Icon = item.icon;
          return (
            <div class="reveal module-card" style="background-color: #ffffff; border-radius: 36px; border: 1px solid #ececee; box-shadow: rgb(228,228,231) 0px 1px 0px 0px inset; padding: 28px;">
              <div style="width: 48px; height: 48px; border-radius: 40px; background-color: #09090b; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                <Icon className="w-5 h-5 text-white" strokeWidth={1.75} />
              </div>
              <h3 style="font-size: 20px; font-weight: 600; color: #09090b; line-height: 1.35; margin-bottom: 10px;">
                {item.title}
              </h3>
              <p style="font-size: 15px; font-weight: 400; color: #71717a; line-height: 1.6;">
                {item.description}
              </p>
            </div>
          );
        })}
      </div>

    </div>
  </section>

  <!-- CTA Section -->
  <section style="background-color: #f4f4f5; padding: 80px 0;">
    <div class="max-w-[1200px] mx-auto px-6 lg:px-8">
      <div
        style="background-color: #09090b; border-radius: 36px; padding: 48px 40px;"
        class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
      >

        <!-- Left: Illustration -->
        <div class="flex justify-center reveal-left">
          <img
            src="/homepage/project-start1.png"
            alt="Project Illustration"
            style="max-width: 420px; width: 100%;"
          />
        </div>

        <!-- Right: Text + CTA -->
        <div class="reveal-right">
          <h2 style="font-size: 40px; font-weight: 700; color: #ffffff; line-height: 1.25; margin-bottom: 20px;">
            Ready to Start Your <span style="color: #a1a1aa;">Project With Us?</span>
          </h2>
          <p style="font-size: 16px; font-weight: 400; color: #a1a1aa; line-height: 1.5; margin-bottom: 32px; max-width: 440px;">
            With proven delivery across multiple sectors, we make business solutions accessible, practical, and built to last.
          </p>
          <a
            href="/contact-us"
            style="
              display: inline-flex;
              align-items: center;
              gap: 8px;
              background-color: #ffffff;
              color: #09090b;
              font-size: 15px;
              font-weight: 500;
              padding: 12px 24px;
              border-radius: 36px;
              text-decoration: none;
              border: 1px solid #3f3f46;
              transition: opacity 0.2s ease;
            "
            onmouseover="this.style.opacity='0.85'"
            onmouseout="this.style.opacity='1'"
          >
            Get Started →
          </a>
        </div>

      </div>
    </div>
  </section>

</MainLayout>

<style>
  .service-card,
  .module-card {
    transition: transform 0.28s ease, box-shadow 0.28s ease;
    cursor: pointer;
  }
  .service-card:hover,
  .module-card:hover {
    transform: translateY(-8px) scale(1.015);
    box-shadow: rgba(0, 0, 0, 0.09) 0px 16px 40px 0px, rgba(0, 0, 0, 0.04) 0px 4px 12px 0px;
  }
</style>
