---
import MainLayout from "../layouts/MainLayout.astro";
import {
  Rocket,
  Laptop,
  Headset,
  PlugZap,
  BarChart3,
  CloudCog,
} from "lucide-react";

const whyChooseUs = [
  {
    title: "Workflow Automation",
    icon: Rocket,
    description:
      "Streamline routine operations with structured processes that improve speed, consistency, and control across your team.",
  },
  {
    title: "Responsive Experience",
    icon: Laptop,
    description:
      "Deliver a clean and accessible experience across desktop, tablet, and mobile without compromising usability.",
  },
  {
    title: "Reliable Support",
    icon: Headset,
    description:
      "Keep operations moving with responsive assistance, issue resolution, and ongoing service support when you need it.",
  },
  {
    title: "System Integration",
    icon: PlugZap,
    description:
      "Connect core business tools, data sources, and external platforms to reduce duplication and improve accuracy.",
  },
  {
    title: "Reporting & Insights",
    icon: BarChart3,
    description:
      "Access meaningful reports and dashboards that help teams monitor performance and make better decisions.",
  },
  {
    title: "Scalable Delivery",
    icon: CloudCog,
    description:
      "Build solutions that can grow with your business, supporting new requirements without disrupting existing operations.",
  },
];

export const services = [
  {
    title: "Digital Marketing",
    icon: "/services/marketing-seo.png",
    items: [
      "Brand Strategy",
      "Campaign Planning",
      "Audience Targeting",
      "Performance Tracking",
    ],
  },
  {
    title: "Accounting",
    icon: "/services/analytical-report.png",
    items: [
      "Bookkeeping Support",
      "Financial Reporting",
      "Reconciliation",
      "Compliance Tracking",
    ],
  },
  {
    title: "Web Development",
    icon: "/services/webcloud.png",
    items: [
      "Business Websites",
      "Web Applications",
      "CMS Solutions",
      "API Integration",
    ],
  },
  {
    title: "Web Designing",
    icon: "/services/web-designing.png",
    items: [
      "Responsive Layouts",
      "UI / UX Design",
      "Landing Pages",
      "Brand Visuals",
    ],
  },
  {
    title: "Graphics Designing",
    icon: "/services/graphic-designing.png",
    items: [
      "Logo Design",
      "Social Media Creatives",
      "Marketing Collateral",
      "Brand Identity Assets",
    ],
  },
  {
    title: "Marketing & SEO",
    icon: "/services/marketing-seo.png",
    items: [
      "Search Visibility",
      "Content Optimization",
      "Keyword Strategy",
      "Lead Generation",
    ],
  },
  {
    title: "Analytical Reports",
    icon: "/services/analytical-report.png",
    items: [
      "MIS Dashboards",
      "KPI Monitoring",
      "Tabular Reports",
      "Trend Analysis",
    ],
  },
  {
    title: "Custom Development",
    icon: "/services/custome-development.png",
    items: [
      "Tailored Features",
      "Business Automation",
      "Workflow Tools",
      "Process Modules",
    ],
  },
  {
    title: "Service Administrations",
    icon: "/services/server-administration.png",
    items: [
      "User Management",
      "Access Controls",
      "Service Monitoring",
      "Administrative Support",
    ],
  },
  {
    title: "QA & QC",
    icon: "/services/QA-EC.png",
    items: [
      "Quality Checks",
      "Test Planning",
      "Validation",
      "Issue Review",
    ],
  },
  {
    title: "Marketing Consultancy",
    icon: "/services/marketing-seo.png",
    items: [
      "Growth Planning",
      "Brand Positioning",
      "Channel Strategy",
      "Campaign Review",
    ],
  },
  {
    title: "Software Support",
    icon: "/services/custome-development.png",
    items: [
      "Feature Updates",
      "Bug Fixing",
      "System Maintenance",
      "Release Support",
    ],
  },
];
---

<MainLayout title="Services">
  <section class="relative overflow-hidden">
    <img
      src="/homepage/page-title-bg.jpg"
      alt="Background Image"
      class="absolute w-full h-70 object-cover scale-190 object-[20%_10%]"
    />
    <div class="relative z-10 max-w-[1400px] mx-auto px-6 py-20">
      <h2 class="text-center text-black text-5xl font-bold mb-4">Services</h2>
      <div class="text-center">
        <span class="text-gray-500 hover:text-orange-500"><a href="/">Home</a></span><span
          class="text-orange-500"
        >
          >
        </span>
        <span>Services</span>
      </div>
    </div>
  </section>

  <section class="relative py-24 overflow-hidden">
    <img
      src="/homepage/black-bg.jpg"
      alt="Background Image"
      class="absolute inset-0 w-full h-full object-cover"
    />

    <div class="relative z-10 max-w-[1400px] mx-auto px-6 ">
      <h2 class="text-center text-white text-3xl font-bold mb-16 reveal">
        Services that We Can Help You With
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-7">
        {
          services.map((service) => (
            <div class="bg-white rounded-sm p-8 min-h-[280px] border border-white/10 reveal">
              <div class="flex justify-center mb-5">
                <img src={service.icon} alt={service.title} class="w-14 h-14" />
              </div>

              <h3 class="text-center text-[24px] font-semibold text-[#25253b] mb-6">
                {service.title}
              </h3>

              <ul class="space-y-3">
                {service.items.map((item) => (
                  <li class="flex gap-3 text-[#6f6f84] text-lg">
                    <span class="w-5 h-5 rounded-full bg-[#f1f2f6] flex items-center justify-center text-[15px]">
                      ✓
                    </span>

                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="max-w-[1400px] mx-auto px-6">
      <div class="text-center mb-16">
        <div class="flex items-center justify-center gap-4 reveal">
          <img
            src="/homepage/star-icon.png"
            alt="start icon image"
            class="animate-spin-slow"
          />
          <span
            class="uppercase text-orange-500 font-semibold tracking-widest text-sm"
          >
            Our Solutions
          </span>
        </div>
        <h2 class="text-4xl font-bold text-[#25253b] mt-4 max-w-4xl mx-auto reveal">
          Generic Modules That Support Every Service
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
        {
          whyChooseUs.map((item) => {
            const Icon = item.icon;

            return (
              <div class="border border-[#ececec] p-10 text-center min-h-[280px] hover:shadow-sm transition reveal">
                <div class="flex justify-center mb-6">
                  <Icon
                    className="w-14 h-14 text-[#ff6b1a]"
                    strokeWidth={1.75}
                  />
                </div>

                <h3 class="font-semibold text-xl text-[#25253b] mb-4">
                  {item.title}
                </h3>

                <p class="text-[#6f6f84] leading-relaxed">{item.description}</p>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden bg-[#221638]">
    <div class="relative z-10 max-w-[1400px] mx-auto px-6 py-24">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="flex justify-center reveal-left">
          <img
            src="/homepage/project-start1.png"
            alt="Project Illustration"
            class="max-w-[600px] w-full"
          />
        </div>

        <div class="reveal-right">
          <h2 class="text-white text-4xl font-bold leading-tight mb-6">
            You Like to Start Your Project With Us
          </h2>

          <p class="text-white/80 text-lg leading-relaxed mb-8 max-w-5xl">
            With successfully delivering business solutions and having served
            clients across multiple sectors, we aim to make business solutions
            accessible to all users.
          </p>

          <a
              href="/contact-us"
              class="cta-btn inline-flex items-center gap-3 bg-orange-500 text-white font-semibold px-4 py-2 md:px-6 md:py-3 rounded-md overflow-hidden"
          >
            Get Started
          </a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .page-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }
</style>
