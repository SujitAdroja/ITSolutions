---
import MainLayout from "../layouts/MainLayout.astro";
import {
  Rocket,
  Laptop,
  Headset,
  PlugZap,
  BarChart3,
  CloudCog,
} from "lucide-react";

const whyChooseUs = [
  {
    title: "Fully Customization",
    icon: Rocket,
    description:
      "As we are providing fully customize software so we can modified software as per your business process.",
  },
  {
    title: "Responsive Design",
    icon: Laptop,
    description: "Our Solutions are fully responsive and Cross Platform.",
  },
  {
    title: "Quick Support",
    icon: Headset,
    description:
      "We Provide online or offline support for any query or problem.",
  },
  {
    title: "Integration",
    icon: PlugZap,
    description:
      "Integrate master and transaction data with Tally, SAP and legacy systems.",
  },
  {
    title: "Analysis",
    icon: BarChart3,
    description:
      "Graphical Report, Tabular Report & Crystal Report integrated for analysis.",
  },
  {
    title: "SaaS Solutions",
    icon: CloudCog,
    description:
      "Provide SaaS solutions so you can start your business with lower cost.",
  },
];

export const services = [
  {
    title: "Web & Cloud Applications",
    icon: "/services/webcloud.png",
    items: [
      ".NET Development",
      ".NET CORE Development",
      "Angular Development",
      "PHP Development",
    ],
  },

  {
    title: "Mobile App Development",
    icon: "/services/mobileApp.png",
    items: [
      "Android App Development",
      "iPhone App Development",
      "Flutter App Development",
      "Xamarin Cross Platform",
    ],
  },

  {
    title: "Web Designing",
    icon: "/services/web-designing.png",
    items: [
      "Responsive Web Design",
      "UI/UX Web-Mobile",
      "Logo / Banner Design",
      "Promotional Ads & Campaign",
    ],
  },

  {
    title: "Marketing & SEO",
    icon: "/services/marketing-seo.png",
    items: [
      "Search Engine Optimization (SEO)",
      "Email Marketing",
      "Social Media Marketing (SMM)",
      "Inbound / Content Marketing",
    ],
  },

  {
    title: "Domain & Web Hosting",
    icon: "/services/domain-web-hosting.png",
    items: [
      "Domain Extensions",
      "Web Hosting",
      "Business Email",
      "SSL Certificate",
    ],
  },

  {
    title: "Analytical Reports",
    icon: "/services/analytical-report.png",
    items: [
      "Graphical & Tabular (MIS) Report",
      "Microsoft Power BI",
      "SAP Crystal Report",
      "Qlik View, Tableau & Sisense",
    ],
  },

  {
    title: "Third-Party Integration",
    icon: "/services/thirdparty-integration.png",
    items: [
      "Payment Gateway Integration",
      "Tally, SAP, SFA & Any Third Party",
      "Social Accounts Integration",
      "Web API / Soap / VoIP",
    ],
  },

  {
    title: "Custom Development",
    icon: "/services/custome-development.png",
    items: [
      "E-Commerce Website",
      "WordPress, Joomla & Magento",
      "CMS Development",
      "Database Administrator",
    ],
  },

  {
    title: "Device Integration",
    icon: "/services/device-integration.png",
    items: [
      "GPS & RFID System",
      "Biometric Fingerprint System",
      "Face Recognition System",
      "Weighing Control Systems",
    ],
  },

  {
    title: "Server Administration",
    icon: "/services/server-administration.png",
    items: [
      "Server Migration / Upgrade",
      "Cloud / OnPrem Integration",
      "Vmware Product Suit Administration",
      "End to End Cloud Solution",
    ],
  },

  {
    title: "QA & QC",
    icon: "/services/QA-EC.png",
    items: [
      "Automation & Manual Testing",
      "Data Scraping",
      "Load (Performance) Testing",
      "API Security Testing",
    ],
  },

  {
    title: "Graphics Designing",
    icon: "/services/graphic-designing.png",
    items: [
      "Logo / Banner Design",
      "All Types Graphics Design",
      "Pouch Design (Roto Gravure)",
      "Company Brochure",
    ],
  },
