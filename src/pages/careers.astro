---
import MainLayout from "../layouts/MainLayout.astro";
import { careerTabs } from "../data/careerData.ts";
---

<MainLayout title="Careers">
  <section class="relative overflow-hidden">
    <img
      src="/homepage/page-title-bg.jpg"
      alt="Background Image"
      class="absolute w-full h-70 object-cover scale-190 object-[20%_10%]"
    />
    <div class="relative max-w-[1400px] mx-auto px-6 py-10 md:py-20">
      <h2 class="text-center text-black text-4xl md:text-5xl font-bold mb-4">
        Careers
      </h2>
      <div class="text-center">
        <span class="text-gray-500 hover:text-orange-500"
          ><a href="/">Home</a></span
        ><span class="text-orange-500"> > </span>
        <span>Careers</span>
      </div>
    </div>
  </section>

  <section class="py-24 z-10">
    <div class="max-w-[1400px] mx-auto px-6">
      <!-- Heading -->

      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-[#25253b] mb-4 reveal">
          Current Opportunities
        </h2>

        <p class="text-[#6f6f84] max-w-3xl mx-auto reveal">
          We offer excellent opportunities for IT professionals. Where remote
          working options are stated, If you are interested please submit a copy
          of your CV.
        </p>
      </div>

      <div class="grid lg:grid-cols-[360px_1fr] gap-10 reveal">
        <!-- LEFT FORM -->

        <div
          class="bg-white shadow-md p-6 md:p-8 border border-[#ececec] order-2 md:order-0"
        >
          <h2 class="text-4xl font-bold text-[#25253b] mb-4 reveal md:hidden">
            Submit Your CV
          </h2>
          <h3 class="text-[#6f6f84] mb-8">
            We'll be glad to see you in our team!
          </h3>

          <form
            class="space-y-4"
            action="https://formsubmit.co/bonebreaker712003@gmail.com"
            method="POST"
            enctype="multipart/form-data"
          >
            <!-- <input
              type="hidden"
              name="access_key"
              value="de838170-800d-4219-846d-90ec3666ffd7"
            /> -->
            <input
              type="text"
              name="name"
              placeholder="Your name"
              class="w-full h-14 px-4 bg-[#f7f7f7] border border-[#ececec]"
            />

            <input
              type="email"
              name="email"
              placeholder="Your email address"
              class="w-full h-14 px-4 bg-[#f7f7f7] border border-[#ececec]"
            />

            <input
              type="text"
              name="mobile"
              placeholder="Your Mobile number"
              class="w-full h-14 px-4 bg-[#f7f7f7] border border-[#ececec]"
            />

            <input
              type="text"
              name="job position"
              placeholder="Job position"
              class="w-full h-14 px-4 bg-[#f7f7f7] border border-[#ececec]"
            />

            <textarea
              rows="5"
              name="message"
              placeholder="Write your message..."
              class="w-full p-4 bg-[#f7f7f7] border border-[#ececec]"
            ></textarea>

            <label
              for="resume"
              class="h-20 border border-[#ff6b1a]/40 flex items-center justify-center cursor-pointer text-[#4b4b66]"
            >
              <span id="file-name">Browse Or Drop Your CV (PDF only)</span>

              <input
                id="resume"
                type="file"
                name="resume"
                accept=".pdf,application/pdf"
                required
                class="hidden"
              />
            </label>

            <button
              type="submit"
              class="cta-btn inline-flex items-center gap-3 bg-orange-500 text-white font-semibold px-4 py-2 md:px-6 md:py-3 rounded-md overflow-hidden"
            >
              Send Message
            </button>
          </form>
        </div>

        <!-- RIGHT SIDE -->

        <div>
          <!-- Tabs -->

          <div class="flex flex-wrap gap-3 mb-8">
            {
              careerTabs.map((tab, index) => (
                <button
                  class={`px-5 py-3 text-sm font-semibold rounded shadow-sm transition ${
                    index === 0
                      ? "bg-[#ff6b1a] text-white"
                      : "bg-white text-[#25253b]"
                  }`}
                  data-tab={tab.id}
                >
                  {tab.label}
                </button>
              ))
            }
          </div>

          <!-- Tab Contents -->

          {
            careerTabs.map((tab, index) => (
              <div
                class={`tab-content ${index !== 0 ? "hidden" : ""}`}
                id={tab.id}
              >
                {tab.jobs.length === 0 ? (
                  <div class="bg-white border border-[#ececec] p-12 text-center shadow-sm">
                    <h3 class="text-2xl font-semibold text-[#25253b]">
                      No Openings Available
                    </h3>

                    <p class="mt-3 text-[#6f6f84]">
                      Currently we don't have any active openings for this role.
                    </p>
                  </div>
                ) : (
                  <div class="space-y-4">
                    {tab.jobs.map((job, idx) => (
                      <details
                        class="bg-white border border-[#ececec] shadow-sm group"
                        open={idx === 0}
                      >
                        <summary class="cursor-pointer px-8 py-5 pb-2 font-bold text-lg text-[#25253b]">
                          {job.title}
                        </summary>

                        <div class="px-8 pb-8 ml-6">
                          <div class="space-y-1 text-[#4b4b66]">
                            <p>
                              <strong>Open Position :</strong>{" "}
                              {job.openPosition}
                            </p>

                            <p>
                              <strong>Experience :</strong> {job.experience}
                            </p>

                            <p>
                              <strong>Employment Type :</strong>{" "}
                              {job.employmentType}
                            </p>

                            <p>
                              <strong>Skills :</strong> {job.skills}
                            </p>
                          </div>
                        </div>
                      </details>
                    ))}
                  </div>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const tabs = document.querySelectorAll("[data-tab]");
    const contents = document.querySelectorAll(".tab-content");

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const target = tab.dataset.tab;

        contents.forEach((content) => {
          content.classList.add("hidden");
        });

        document.getElementById(target)?.classList.remove("hidden");

        tabs.forEach((t) => {
          t.classList.remove("bg-[#ff6b1a]", "text-white");

          t.classList.add("bg-white", "text-[#25253b]");
        });

        tab.classList.remove("bg-white", "text-[#25253b]");

        tab.classList.add("bg-[#ff6b1a]", "text-white");
      });
    });
  });
</script>

<script is:inline>
  const resumeInput = document.getElementById("resume");
  const fileName = document.getElementById("file-name");

  resumeInput?.addEventListener("change", (e) => {
    const file = e.target.files[0];

    if (!file) return;

    if (file.type !== "application/pdf") {
      alert("Please upload a PDF file only.");
      resumeInput.value = "";
      fileName.textContent = "Browse Or Drop Your CV (PDF only)";
      return;
    }

    fileName.textContent = file.name;
  });
</script>
