---
import MainLayout from "../layouts/MainLayout.astro";

const roles = ['Accounting', 'Digital Marketing', 'Software Development', 'QA & Testing', 'UI / UX Design'];
---

<MainLayout
  title="Careers | Developer & IT Jobs in the UK — EchoEleganceLtd.uk"
  description="Join EchoEleganceLtd.uk, a fast-growing UK staff augmentation and IT delivery company. We hire React, Angular, Node.js, Flutter, UI/UX, QA, marketing and accounting professionals. Submit your CV today."
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Careers', href: '/careers' }]}
>

  <section class="page-hero">
    <div class="container-x py-14 md:py-20">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">›</span>
        <span>Careers</span>
      </nav>
      <h1 class="h-display">Join Our <span class="text-gradient">Team</span></h1>
      <p class="lead mt-5 max-w-xl">
        Submit your profile and let us know where you want to contribute — across marketing, accounting, and software development.
      </p>
    </div>
  </section>

  <section class="section bg-bg-alt">
    <div class="container-x">
      <div class="grid grid-cols-1 items-stretch gap-6 lg:grid-cols-2">

        <!-- Info card -->
        <div class="card reveal-left flex flex-col p-4">
          <div class="h-56 shrink-0 overflow-hidden rounded-2xl sm:h-64">
            <img
              src="/services/career-hero.png"
              alt="Careers at EchoElegance"
              class="h-full w-full object-cover"
              loading="lazy"
            />
          </div>
          <div class="p-4 pt-7 sm:p-6 sm:pt-8">
            <span class="eyebrow">Join Our Team</span>
            <h2 class="mt-4 text-2xl font-bold leading-snug text-fg md:text-3xl">
              Work with a team that values <span class="text-gradient">clarity and quality.</span>
            </h2>
            <p class="mt-3 text-sm leading-relaxed text-muted md:text-base">
              We welcome professionals who want to contribute to accounting, marketing, and software projects with a structured and dependable approach.
            </p>
            <div class="mt-5 flex flex-wrap gap-2">
              {roles.map((role) => (
                <span class="rounded-full border border-line bg-bg-alt px-3 py-1.5 text-xs font-medium text-fg-2">{role}</span>
              ))}
            </div>
          </div>
        </div>

        <!-- Form card -->
        <div class="card reveal-right flex flex-col p-6 sm:p-8 md:p-10">
          <div class="mb-7">
            <span class="eyebrow">Apply Now</span>
            <h2 class="mt-4 text-2xl font-bold text-fg md:text-3xl">Submit Your CV</h2>
            <p class="mt-2 text-sm leading-relaxed text-muted md:text-base">
              We review applications carefully and reach out when there is a suitable match.
            </p>
          </div>

          <form
            action="https://formsubmit.co/runa@echoeleganceltd.uk"
            method="POST"
            enctype="multipart/form-data"
            class="flex flex-col gap-3"
          >
            <input type="text" name="name" placeholder="Your name" class="input" required />
            <input type="email" name="email" placeholder="Your email address" class="input" required />
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
              <input type="tel" name="mobile" placeholder="Mobile number" class="input" />
              <input type="text" name="job position" placeholder="Job position" class="input" />
            </div>
            <textarea rows="4" name="message" placeholder="Write your message..." class="input resize-none"></textarea>

            <label for="resume" class="upload-zone">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 16V4m0 0-4 4m4-4 4 4"/><path d="M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/>
              </svg>
              <span id="file-name" class="text-sm font-medium text-fg-2">Browse or drop your CV (PDF only)</span>
              <span class="text-xs text-muted-2">Recommended file type: PDF</span>
              <input id="resume" type="file" name="resume" accept=".pdf,application/pdf" required class="sr-only" />
            </label>

            <button type="submit" class="btn-primary mt-2 w-full">
              Send Application
              <svg class="arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
          </form>
        </div>

      </div>
    </div>
  </section>

</MainLayout>

<style>
  .upload-zone {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 96px;
    padding: 16px;
    border-radius: 12px;
    border: 1.5px dashed var(--line-strong);
    background: var(--bg-alt);
    color: var(--brand);
    cursor: pointer;
    text-align: center;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .upload-zone:hover,
  .upload-zone:focus-within {
    border-color: var(--brand);
    background: var(--brand-soft);
  }
</style>

<script>
  const resumeInput = document.getElementById("resume") as HTMLInputElement;
  const fileName = document.getElementById("file-name");
  const defaultText = "Browse or drop your CV (PDF only)";

  resumeInput?.addEventListener("change", (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    if (file.type !== "application/pdf") {
      alert("Please upload a PDF file only.");
      resumeInput.value = "";
      if (fileName) fileName.textContent = defaultText;
      return;
    }
    if (fileName) fileName.textContent = file.name;
  });
</script>
