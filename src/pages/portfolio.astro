---
import MainLayout from "../layouts/MainLayout.astro";
import { portfolioItems } from "../data/portfolioData.ts";
---

<MainLayout
  title="Portfolio | Software & Web Projects Delivered Fast in the UK — EchoEleganceLtd.uk"
  description="Explore web, mobile and e-commerce projects delivered on time by EchoEleganceLtd.uk — the UK's quick-delivery IT company and staff augmentation partner."
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Portfolio', href: '/portfolio' }]}
>

  <section class="page-hero">
    <div class="container-x py-14 md:py-20">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">›</span>
        <span>Portfolio</span>
      </nav>
      <h1 class="h-display">Our <span class="text-gradient">Portfolio</span></h1>
      <p class="lead mt-5 max-w-xl">
        We've discovered the secret of winning customers — it's all about delivering quality projects.
      </p>
    </div>
  </section>

  <section class="section bg-bg-alt">
    <div class="container-x">
      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {portfolioItems.map((item) => (
          <article class="card card-hover reveal group flex flex-col overflow-hidden">
            <div class="overflow-hidden">
              <img
                src={item.image}
                alt={item.title}
                class="h-52 w-full object-cover transition duration-500 group-hover:scale-105"
                loading="lazy"
              />
            </div>
            <div class="flex flex-1 flex-col gap-2 p-6">
              <h3 class="text-lg font-semibold leading-snug text-fg md:text-xl">{item.title}</h3>
              <p class="text-sm leading-relaxed text-muted">{item.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-bg pb-16 md:pb-24 pt-16 md:pt-24">
    <div class="container-x">
      <div class="banner-navy reveal grid items-center gap-10 p-8 md:p-14 lg:grid-cols-2">
        <div class="flex justify-center lg:order-last">
          <img
            src="/homepage/project-start1.png"
            alt="Project illustration"
            class="w-full max-w-md object-contain"
            loading="lazy"
          />
        </div>
        <div>
          <h2 class="text-3xl font-bold leading-tight md:text-4xl">
            Want to Become <span class="text-sky-300">Our Partner?</span>
          </h2>
          <p class="mt-4 text-sm leading-relaxed text-white/65 md:text-base">
            With successfully delivered business solutions and clients across multiple sectors, we aim to make business solutions accessible to all.
          </p>
          <a href="/contact-us" class="btn-primary mt-8 w-full sm:w-auto">
            Contact Us
            <svg class="arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

</MainLayout>
