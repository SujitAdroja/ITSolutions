---
import MainLayout from "../layouts/MainLayout.astro";

import { portfolioItems, clientLogos } from "../data/portfolioData.ts";
---

<MainLayout title="Portfolio">
  <section class="relative">
    <img
      src="/public/homepage/page-title-bg.jpg"
      alt="Background Image"
      class="absolute w-full h-70 object-cover"
    />
    <div class="relative z-10 max-w-[1400px] mx-auto px-6 py-20">
      <h2 class="text-center text-black text-4xl font-bold mb-4">Portfolio</h2>
      <div class="text-center">
        <span class="text-gray-500 hover:text-orange-500">Home</span><span
          class="text-orange-500"
        >
          >
        </span>
        <span>Portfolio</span>
      </div>
    </div>
  </section>
  <section class="relative py-24 overflow-hidden">
    <!-- Background Image -->
    <img
      src="/homepage/black-bg.jpg"
      alt=""
      class="absolute inset-0 w-full h-full object-cover"
    />

    <div class="relative z-10 max-w-[1400px] mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-white mb-4">
          Amazing Portfolio You Might Like
        </h2>

        <p class="text-md text-white/80 max-w-3xl mx-auto">
          We've discovered the secret of winning customers — it's all about
          delivering quality projects.
        </p>
      </div>

      <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-8">
        {
          portfolioItems.map((item) => (
            <div class="bg-white rounded overflow-hidden shadow-md hover:-translate-y-1 transition">
              <img
                src={item.image}
                alt={item.title}
                class="w-full h-[220px] object-cover"
              />

              <div class="p-5">
                <h3 class="text-xl font-semibold text-[#25253b] mb-3 text-center">
                  {item.title}
                </h3>

                <p class="text-[#ff6b1a] text-md leading-relaxed text-center">
                  {item.description}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

<!-- cta section -->
   <section class="relative overflow-hidden bg-[#221638]">
    <!-- Background Image -->
    <img src="/portfolio/vector-shape3.png" alt="Background Image" class="absolute inset-0 w-100 h-100 object-cover left-50 md:left-100 lg:left-300 top-180 md:top-150 lg:top-10" />

    <div class="relative z-10 max-w-[1400px] mx-auto px-6 py-24">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Illustration -->
        <div class="flex justify-center">
          <img
            src="/public/homepage/project-start1.png"
            alt="Project Illustration"
            class="max-w-[600px] w-full"
          />
        </div>

        <!-- Content -->
        <div>
          <h2 class="text-white text-4xl font-bold leading-tight mb-6">
            You Want to Became Our Partner
          </h2>

          <p class="text-white/80 text-lg leading-relaxed mb-8 max-w-5xl">
           With successfully delivering business solutions and having served clients across multiple sectors, we aim to make business solutions accessible to all users.
          </p>

          <button
            class="bg-[#ff6b1a] hover:bg-[#e55d13] text-white px-8 py-4 rounded-md font-semibold transition"
          >
            Contact Us
          </button>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
