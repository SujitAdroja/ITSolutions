---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
}

const { href, variant = 'primary', type = 'button', class: className } = Astro.props;
---

{href ? (
  <a href={href} class:list={['btn', `btn-${variant}`, className]}>
    <slot />
  </a>
) : (
  <button type={type} class:list={['btn', `btn-${variant}`, className]}>
    <slot />
  </button>
)}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.625rem 1.25rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    border: none;
    transition: opacity 0.2s, box-shadow 0.2s;
  }

  .btn:hover {
    opacity: 0.9;
  }

  .btn-primary {
    background: #111827;
    color: #fff;
  }

  .btn-secondary {
    background: #f3f4f6;
    color: #111827;
  }

  .btn-outline {
    background: transparent;
    color: #111827;
    border: 1px solid #d1d5db;
  }
</style>
