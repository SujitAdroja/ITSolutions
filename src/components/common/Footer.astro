---
const year = new Date().getFullYear();
 

export const offices = [
  {
    country: "INDIA",
    address: [
      "604, Sahitya Business Park",
      "Kathwada Road Ahmedabad",
      "Gujarat - 382350",
    ],
    phone: "+91 70169 38647",
  },
  {
    country: "LONDON",
    address: [
      "EchoElegance",
      "35 Sidmouth Close, Watford - WD19 7QN",
      "Watford, UK",
    ],
    phone: "+44 7763 587474",
  },
];

const contactDetails = [
  {
    label: "Email",
    value: "echoelgance@hotmail.com",
    href: "mailto:echoelgance@hotmail.com",
  },
];
---

<footer class="relative bg-[#FEFCF8] overflow-hidden reveal">
  <img
    src="/homepage/footer-map.png"
    alt=""
    class="absolute inset-0 w-150 h-full object-contain opacity-80 pointer-events-none left-30 xl:left-150 top-0 animate-float-horizontal"
  />

  <div class="relative z-10 max-w-[1400px] mx-auto px-6">
    <div class="grid gap-12 py-24 md:grid-cols-3">
      <div class="max-w-sm">
        <div class="mb-8">
          <h3 class="text-xl font-bold text-[#222] mb-4">EchoEleganceLTD Solutions</h3>
          <p class="text-[#666a87] text-md leading-relaxed">
            Trusted support for accounting, digital marketing, and software development with practical delivery and long-term partnership.
          </p>
        </div>

        <div class="space-y-3">
          {contactDetails.map((contact) => (
            <a
              href={contact.href}
              class="flex items-center gap-3 text-[#666a87] text-md hover:text-[#222] transition-colors"
            >
              <span class="font-semibold text-[#222]">{contact.label}:</span>
              <span>{contact.value}</span>
            </a>
          ))}
        </div>
      </div>

      {offices.map((office) => (
        <div>
          <h3 class="text-xl font-bold text-[#222] mb-8">{office.country}</h3>

          <div class="space-y-3">
            <div class="text-[#666a87] leading-relaxed text-md">
              {office.address.map((line) => (
                <div>{line}</div>
              ))}
            </div>

            {/* <div class="text-[#666a87] text-md">{office.phone}</div> */}
          </div>
        </div>
      ))}
    </div>

    <div class="border-t border-[#ececec]"></div>

    <div class="py-8 flex flex-col md:flex-row justify-between items-center gap-6">
      <p class="text-[#666a87] text-[18px]">
        © {year} EchoEleganceLTD Solutions All Rights Reserved
      </p>
    </div>
  </div>
</footer>

<a
  href="https://wa.me/917914938647"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat on WhatsApp"
  class="fixed bottom-6 left-5 z-50 w-12 h-12 bg-green-500 hover:bg-green-600 rounded-full flex items-center justify-center shadow-lg transition-colors duration-200"
>
  <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
    <path
      d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
    ></path>
  </svg>
</a>
