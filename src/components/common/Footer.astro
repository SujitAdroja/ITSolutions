---
const year = new Date().getFullYear();

const offices = [
  {
    label: "India",
    lines: [
      "604, Sahitya Business Park",
      "Kathwada Road, Ahmedabad",
      "Gujarat — 382350",
    ],
    phone: "+91 70169 38647",
  },
  {
    label: "London",
    lines: [
      "EchoElegance",
      "35 Sidmouth Close, Watford",
      "WD19 7QN, UK",
    ],
    phone: "+44 7763 587474",
  },
];

const quickLinks = [
  { label: "Home", href: "/" },
  { label: "Products", href: "/products" },
  { label: "Services", href: "/services" },
  { label: "Careers", href: "/careers" },
  { label: "About Us", href: "/about-us" },
  { label: "Contact Us", href: "/contact-us" },
];
---

<footer style="background-color: #09090b; padding: 80px 0 0;">
  <div class="max-w-[1200px] mx-auto px-6 lg:px-8">

    <!-- Main grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12" style="padding-bottom: 64px;">

      <!-- Col 1: Brand -->
      <div style="display: flex; flex-direction: column; gap: 20px;">
        <a href="/" style="display: inline-flex; text-decoration: none;">
          <img
            src="/logo/Logo-Img.png"
            alt="EchoEleganceLTD"
            style="height: 32px; width: auto; object-fit: contain; filter: brightness(0) invert(1);"
          />
        </a>
        <p style="font-size: 14px; font-weight: 400; color: #71717a; line-height: 1.7; max-width: 220px;">
          Trusted support for accounting, digital marketing, and software development.
        </p>
        <a
          href="mailto:echoelgance@hotmail.com"
          style="font-size: 13px; font-weight: 500; color: #a1a1aa; text-decoration: none; transition: color 0.2s ease;"
          class="footer-link"
        >
          echoelgance@hotmail.com
        </a>
      </div>

      <!-- Col 2: Quick links -->
      <div style="display: flex; flex-direction: column; gap: 16px;">
        <p style="font-size: 11px; font-weight: 600; color: #3f3f46; letter-spacing: 0.08em; text-transform: uppercase;">
          Navigation
        </p>
        <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px;">
          {quickLinks.map(({ label, href }) => (
            <li>
              <a
                href={href}
                class="footer-link"
                style="font-size: 14px; font-weight: 400; color: #71717a; text-decoration: none; transition: color 0.2s ease;"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: India -->
      <div style="display: flex; flex-direction: column; gap: 16px;">
        <p style="font-size: 11px; font-weight: 600; color: #3f3f46; letter-spacing: 0.08em; text-transform: uppercase;">
          India
        </p>
        <div style="display: flex; flex-direction: column; gap: 6px;">
          {offices[0].lines.map((line) => (
            <span style="font-size: 14px; font-weight: 400; color: #71717a; line-height: 1.6;">{line}</span>
          ))}
        </div>
        <a
          href={`tel:${offices[0].phone.replace(/\s/g,'')}`}
          class="footer-link"
          style="font-size: 13px; font-weight: 500; color: #a1a1aa; text-decoration: none; transition: color 0.2s ease; margin-top: 4px;"
        >
          {offices[0].phone}
        </a>
      </div>

      <!-- Col 4: London -->
      <div style="display: flex; flex-direction: column; gap: 16px;">
        <p style="font-size: 11px; font-weight: 600; color: #3f3f46; letter-spacing: 0.08em; text-transform: uppercase;">
          London
        </p>
        <div style="display: flex; flex-direction: column; gap: 6px;">
          {offices[1].lines.map((line) => (
            <span style="font-size: 14px; font-weight: 400; color: #71717a; line-height: 1.6;">{line}</span>
          ))}
        </div>
        <a
          href={`tel:${offices[1].phone.replace(/\s/g,'')}`}
          class="footer-link"
          style="font-size: 13px; font-weight: 500; color: #a1a1aa; text-decoration: none; transition: color 0.2s ease; margin-top: 4px;"
        >
          {offices[1].phone}
        </a>
      </div>

    </div>

    <!-- Bottom bar -->
    <div style="border-top: 1px solid rgba(255,255,255,0.07); padding: 24px 0; display: flex; flex-direction: column; gap: 12px; align-items: center; justify-content: space-between;" class="md:flex-row">
      <p style="font-size: 13px; font-weight: 400; color: #3f3f46; margin: 0;">
        © {year} EchoEleganceLTD Solutions. All rights reserved.
      </p>
    </div>

  </div>
</footer>

<!-- WhatsApp FAB -->
<a
  href="https://wa.me/917914938647"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat on WhatsApp"
  style="position: fixed; bottom: 24px; left: 20px; z-index: 50; width: 48px; height: 48px; background-color: #22c55e; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 16px rgba(34,197,94,0.35); transition: background-color 0.2s ease;"
  class="whatsapp-fab"
>
  <svg width="24" height="24" fill="#ffffff" viewBox="0 0 24 24">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
  </svg>
</a>

<style>
  .footer-link:hover {
    color: #ffffff !important;
  }
  .footer-cta:hover {
    opacity: 0.85;
  }
  .whatsapp-fab:hover {
    background-color: #16a34a !important;
  }
</style>
