---
import { Image } from 'astro:assets';
import logo from '../../assets/logo/Logo-Img.png';

const year = new Date().getFullYear();

const offices = [
  {
    label: "London Office",
    lines: ["Unit 1, Liberty Centre", "Mount Pleasant, Wembley", "HA0 1TX, United Kingdom"],
  },
];

const whatsappNumber = "919586056000";
const whatsappMessage =
  "Hello EchoElegance team, I visited your website and would like to discuss my project requirements.";
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;

const quickLinks = [
  { label: "Home", href: "/" },
  { label: "Products", href: "/products" },
  { label: "Services", href: "/services" },
  { label: "Careers", href: "/careers" },
  { label: "About Us", href: "/about-us" },
  { label: "Contact Us", href: "/contact-us" },
];
---

<footer class="site-footer relative overflow-hidden bg-navy text-white">
  <!-- brand glow -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-brand to-transparent"></div>
  <div aria-hidden="true" class="pointer-events-none absolute -right-32 -top-32 size-[420px] rounded-full bg-brand/20 blur-3xl"></div>

  <div class="container-x relative pt-16 md:pt-20">
    <div class="grid grid-cols-1 gap-12 pb-14 sm:grid-cols-2 lg:grid-cols-12 lg:gap-8">

      <!-- Brand -->
      <div class="flex flex-col gap-5 sm:col-span-2 lg:col-span-6">
        <a href="/" class="inline-flex w-fit" aria-label="EchoEleganceLtd.uk — Home">
          <Image
            src={logo}
            alt="EchoEleganceLtd.uk"
            class="footer-logo h-14 w-auto object-contain md:h-16"
            format="webp"
            widths={[250, 290, 500, 580]}
            sizes="(min-width: 768px) 286px, 250px"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="max-w-sm text-sm leading-relaxed text-white/60">
          Trusted IT solutions partner for accounting, digital marketing, and
          software development — helping UK businesses scale with confidence.
        </p>
        <a
          href="mailto:info@echoeleganceltd.uk"
          class="footer-link inline-flex w-fit items-center gap-2 text-sm font-medium text-white/80"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>
          </svg>
          info@echoeleganceltd.uk
        </a>
      </div>

      <!-- Navigation -->
      <div class="flex flex-col gap-4 lg:col-span-3">
        <p class="text-xs font-bold uppercase tracking-[0.12em] text-white/80">Navigation</p>
        <ul class="flex flex-col gap-2.5">
          {quickLinks.map(({ label, href }) => (
            <li>
              <a href={href} class="footer-link text-sm text-white/60">{label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Offices -->
      {offices.map((office) => (
        <div class="flex flex-col gap-4 lg:col-span-3">
          <p class="text-xs font-bold uppercase tracking-[0.12em] text-white/80">{office.label}</p>
          <address class="flex flex-col gap-1.5 not-italic">
            {office.lines.map((line) => (
              <span class="text-sm leading-relaxed text-white/60">{line}</span>
            ))}
          </address>
        </div>
      ))}

    </div>

    <!-- Bottom bar -->
    <div class="flex flex-col items-center justify-between gap-3 border-t border-white/10 py-6 text-center md:flex-row md:text-left">
      <p class="text-[13px] text-white/45">
        © {year} EchoEleganceLtd.uk. All rights reserved.
      </p>
      <p class="text-[13px] text-white/45">
        IT Solutions · London, United Kingdom
      </p>
    </div>
  </div>
</footer>

<!-- WhatsApp FAB -->
<a
  href={whatsappHref}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat on WhatsApp"
  class="whatsapp-fab fixed bottom-5 left-4 z-50 flex size-12 items-center justify-center rounded-full bg-[#22c55e] text-white shadow-[0_8px_24px_rgba(34,197,94,0.4)] transition hover:-translate-y-0.5 hover:bg-[#16a34a] md:bottom-6 md:left-6"
>
  <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
  </svg>
</a>

<style>
  /* Footer is navy in both themes — remap the logo's navy text to light */
  .footer-logo {
    filter: invert(1) hue-rotate(185deg) brightness(1.15) saturate(1.1);
  }
  .footer-link {
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .footer-link:hover {
    color: #ffffff;
  }
</style>
