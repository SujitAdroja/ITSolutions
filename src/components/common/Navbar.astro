---
const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Products', href: '/products' },
  { label: 'Portfolio', href: '/portfolio' },
  { label: 'Services', href: '/services' },
  { label: 'Careers', href: '/careers' },
  { label: 'About Us', href: '/about-us' },
  { label: 'Contact Us', href: '/contact-us' },
];

const currentPath = Astro.url.pathname;
---

<nav class="bg-white shadow-sm sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex items-center justify-between py-6">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 shrink-0">
        <div class="w-9 h-9 rounded-lg overflow-hidden flex items-center justify-center bg-gradient-to-br from-cyan-400 to-blue-600">
          <img src="" alt="Logo" class="w-full h-full object-cover" id="navbar-logo" />
          <span class="text-white font-black text-base hidden" id="navbar-logo-fallback">S</span>
        </div>
        <div class="leading-tight">
          <div class="font-black text-gray-900 text-sm tracking-widest uppercase">Shahastra</div>
          <div class="text-[10px] text-cyan-500 tracking-[0.2em] uppercase font-semibold">Solutions</div>
        </div>
      </a>

      <!-- Desktop Nav -->
      <ul class="hidden lg:flex items-center">
        {navLinks.map(({ label, href }) => (
          <li>
            <a
              href={href}
              class:list={[
                'px-3 py-2 text-md font-medium transition-colors duration-150',
                (currentPath === href || (href !== '/' && currentPath.startsWith(href)))
                  ? 'text-orange-500'
                  : 'text-black hover:text-orange-500'
              ]}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Mobile menu button -->
      <button class="lg:hidden p-2 rounded-md text-gray-700 hover:text-orange-500" id="mobile-menu-btn" aria-label="Open menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div class="lg:hidden hidden bg-white border-t border-gray-100 px-6 pb-4" id="mobile-menu">
    {navLinks.map(({ label, href }) => (
      <a
        href={href}
        class:list={[
          'block py-2 text-sm font-medium transition-colors',
          (currentPath === href || (href !== '/' && currentPath.startsWith(href)))
            ? 'text-orange-500'
            : 'text-gray-700 hover:text-orange-500'
        ]}
      >
        {label}
      </a>
    ))}
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));

  const logo = document.getElementById('navbar-logo') as HTMLImageElement;
  const fallback = document.getElementById('navbar-logo-fallback');
  if (logo && !logo.src) {
    logo.classList.add('hidden');
    fallback?.classList.remove('hidden');
  }
</script>
