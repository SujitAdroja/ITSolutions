---
const highlights = ['Staff Augmentation', 'Software Development', 'Digital Marketing', 'Accounting'];
---

<section class="relative overflow-hidden bg-bg-alt">
  <!-- Decorative brand glow + grid -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0" style="background-image: var(--hero-glow);"></div>
  <div aria-hidden="true" class="hero-grid pointer-events-none absolute inset-0 opacity-[0.35] dark:opacity-[0.18]"></div>

  <div class="container-x relative py-16 md:py-24 lg:py-28">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">

      <!-- Copy -->
      <div class="reveal-left order-2 text-center lg:order-1 lg:text-left">
        <span class="eyebrow">Best Staff Augmentation Company · United Kingdom</span>

        <h1 class="mt-5 text-4xl font-bold leading-[1.1] tracking-tight text-fg sm:text-5xl lg:text-[52px] xl:text-6xl">
          The UK's Best Staff Augmentation &amp;
          <span class="text-gradient">Quick-Delivery IT Company</span>
        </h1>

        <p class="lead mx-auto mt-6 max-w-lg lg:mx-0">
          Hire vetted React, Angular, Node.js, Flutter and cloud developers within days — or get your software shipped in fast, predictable sprints. 50+ developers delivered, 100% client satisfaction.
        </p>

        <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center lg:justify-start">
          <a href="/services#staff-augmentation" class="btn-primary w-full sm:w-auto">
            Hire Developers
            <svg class="arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/contact-us" class="btn-secondary w-full sm:w-auto">Get a Quote</a>
        </div>

        <ul class="mt-8 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 lg:justify-start">
          {highlights.map((item) => (
            <li class="flex items-center gap-2 text-sm font-medium text-fg-2">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-brand" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <!-- Illustration -->
      <div class="reveal-right order-1 flex justify-center lg:order-2 lg:justify-end">
        <div class="relative w-full max-w-md lg:max-w-xl">
          <div aria-hidden="true" class="absolute inset-6 rounded-full bg-brand/15 blur-3xl"></div>
          <img
            src="/homepage/banner-img1.png"
            alt="Business solutions illustration"
            class="animate-float-y relative h-auto w-full object-contain"
            width="800"
            height="640"
            fetchpriority="high"
          />
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .hero-grid {
    background-image:
      linear-gradient(to right, var(--line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--line) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
  }
</style>
