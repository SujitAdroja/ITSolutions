---

---

<section style="background-color: #f4f4f5;">
  <div class="max-w-[1200px] mx-auto px-6 lg:px-8 py-20 lg:py-28">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

      <!-- Left: Headline + CTA -->
      <div class="reveal-left order-2 lg:order-1">
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6"
          style="line-height: 1.12; color: #09090b; letter-spacing: normal;"
        >
          Innovative Solutions To Drive Your Business
          <span style="color: #2563eb;">Forward</span>
        </h1>
        <p
          class="text-sm md:text-base mb-8 max-w-md"
          style="font-weight: 400; line-height: 1.5; color: #18181b;"
        >
          Delivering innovative technology solutions that help businesses scale, automate, and grow.
        </p>
        <a
          href="/contact-us"
          class="text-sm md:text-base"
          style="
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background-color: #09090b;
            color: #ffffff;
            font-weight: 500;
            padding: 12px 20px;
            border-radius: 36px;
            text-decoration: none;
            box-shadow:
              rgba(255,255,255,0.5) 0px 0.5px 0px 0px inset,
              rgba(117,123,133,0.4) 0px 9px 14px -5px inset,
              rgb(44,46,52) 0px 0px 0px 1.5px,
              rgba(0,0,0,0.14) 0px 4px 6px 0px;
            transition: opacity 0.2s ease;
          "
          onmouseover="this.style.opacity='0.88'"
          onmouseout="this.style.opacity='1'"
        >
          Get Started
          <span style="transition: transform 0.2s ease;" class="arrow">→</span>
        </a>
      </div>

      <!-- Right: Illustration -->
      <div class="flex justify-center lg:justify-end reveal-right order-1 lg:order-2">
        <img
          src="/homepage/banner-img1.png"
          alt="Business Solutions Illustration"
          class="w-full max-w-md lg:max-w-lg h-100 lg:h-150 object-contain md:scale-130"
        />
      </div>

    </div>
  </div>
</section>
