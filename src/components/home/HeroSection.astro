---
---

<section class="relative overflow-hidden" style="background-color: #dff5fb;">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 pt-16 pb-32 lg:pt-20 lg:pb-40">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 items-center">

      <!-- Left: Text -->
      <div class="reveal-left">
        <h1 class="text-4xl lg:text-5xl font-black text-gray-900 leading-tight mb-4">
          Best Solutions For<br />Your Business
        </h1>
        <p class="text-gray-500 text-base mb-8 max-w-md leading-relaxed">
          We push ourselves. We push technology. And we punch the boundaries of conventional thinking.
        </p>
        <a
          href="/contact-us"
          class="inline-flex items-center gap-2 bg-orange-500 hover:bg-orange-600 text-white font-semibold px-6 py-3 rounded-md transition-colors duration-200 text-sm"
        >
          <span>&rarr;</span> Get Started
        </a>
      </div>

      <!-- Right: Illustration -->
      <div class="flex justify-center lg:justify-end reveal-right">
        <img
          src="/homepage/banner-img1.png"
          alt="Business Solutions Illustration"
          class="w-full max-w-md lg:max-w-lg h-100 lg:h-150 object-contain"
        />
      </div>

    </div>
  </div>

  <!-- Wave bottom -->
  <div class="absolute bottom-0 left-0 right-0">
    <svg viewBox="0 0 1440 80" xmlns="http://www.w3.org/2000/svg" class="w-full block">
      <path fill="#ffffff" d="M0,40 C240,80 480,0 720,40 C960,80 1200,0 1440,40 L1440,80 L0,80 Z" />
    </svg>
  </div>
</section>
