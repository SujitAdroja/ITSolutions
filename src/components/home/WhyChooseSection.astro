---
const points = [
  { lead: 'Forget about', key: 'disconnected teams and siloed services' },
  { lead: 'No more', key: 'guessing at financial accuracy or marketing ROI' },
  { lead: 'Stop settling for', key: 'slow software delivery and missed deadlines' },
  { lead: 'Say goodbye to', key: 'vendors who disappear after handoff' },
];

const featureCards = [
  {
    icon: '/services/analytical-report.png',
    title: 'Accurate Accounting',
    description: 'Maintain clarity in bookkeeping, financial reporting, and compliance so your numbers stay accurate and decision-ready.',
  },
  {
    icon: '/services/marketing-seo.png',
    title: 'Performance Marketing',
    description: 'Brand visibility, audience growth, and performance-driven campaigns with measurable results and stronger engagement.',
  },
  {
    icon: '/services/custome-development.png',
    title: 'Reliable Software Delivery',
    description: 'Turn business requirements into dependable digital products — from internal tools and automation to scalable web and mobile solutions. No missed deadlines, no disappearing vendors.',
  },
];
---

<section class="section bg-bg-alt">
  <div class="container-x">

    <div class="reveal mb-10 md:mb-12">
      <span class="eyebrow">Why Choose Us</span>
      <h2 class="h-section mt-4 max-w-xl">
        Why EchoEleganceLtd is the <span class="text-gradient">Right Choice for You</span>
      </h2>
    </div>

    <div class="wcus-grid">
      {featureCards.map((card, i) => (
        <article class:list={['card card-hover reveal flex flex-col gap-4 p-7', `wcus-card--${['a', 'b', 'c'][i]}`]}>
          <div class="icon-tile">
            <img src={card.icon} alt="" class="size-7 object-contain" loading="lazy" />
          </div>
          <h3 class="text-xl font-semibold leading-snug text-fg">{card.title}</h3>
          <p class="max-w-md text-sm leading-relaxed text-muted md:text-[15px]">{card.description}</p>
        </article>
      ))}

      <!-- Navy highlight card -->
      <div class="banner-navy wcus-card--d reveal flex flex-col justify-between gap-8 p-8 md:p-9">
        <div>
          <h3 class="text-2xl font-bold leading-tight md:text-[28px]">
            Why Choose <span class="text-sky-300">Us?</span>
          </h3>
          <ul class="mt-6 flex flex-col gap-4">
            {points.map((p) => (
              <li class="flex items-start gap-3">
                <span class="mt-2 size-1.5 shrink-0 rounded-full bg-sky-300"></span>
                <p class="text-[15px] leading-snug">
                  <span class="text-white/60">{p.lead} </span>
                  <span class="font-semibold text-white">{p.key}</span>
                </p>
              </li>
            ))}
          </ul>
        </div>
        <a href="/about-us" class="btn-ghost w-full sm:w-auto lg:w-full">
          More About Us
          <svg class="arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .wcus-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 640px) {
    .wcus-grid { grid-template-columns: 1fr 1fr; }
    .wcus-card--c, .wcus-card--d { grid-column: span 2; }
  }
  @media (min-width: 1024px) {
    .wcus-grid {
      grid-template-columns: 1fr 1fr 1fr;
      grid-template-rows: auto auto;
      gap: 18px;
    }
    .wcus-card--a { grid-column: 1;     grid-row: 1; }
    .wcus-card--b { grid-column: 2;     grid-row: 1; }
    .wcus-card--c { grid-column: 1 / 3; grid-row: 2; }
    .wcus-card--d { grid-column: 3;     grid-row: 1 / 3; }
  }
</style>
