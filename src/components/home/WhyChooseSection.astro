---
const points = [
  { lead: 'Forget about', key: 'disconnected teams and siloed services' },
  { lead: 'No more', key: 'guessing at financial accuracy or marketing ROI' },
  { lead: 'Stop settling for', key: 'slow software delivery and missed deadlines' },
  { lead: 'Say goodbye to', key: 'vendors who disappear after handoff' },
];
---

<section style="background-color: #f4f4f5; padding: 80px 0;">
  <div class="max-w-[1200px] mx-auto px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch">

      <!-- Left: Dark Problem Panel -->
      <div
        class="reveal-left"
        style="background-color: #09090b; border-radius: 36px; padding: 48px 40px; display: flex; flex-direction: column; justify-content: space-between; gap: 32px;"
      >
        <div>
          <h2 style="font-size: 40px; font-weight: 700; color: #ffffff; line-height: 1.25; margin-bottom: 32px;">
            Why Choose Us?
          </h2>

          <div style="display: flex; flex-direction: column; gap: 20px;">
            {points.map((p) => (
              <div style="display: flex; align-items: flex-start; gap: 14px;">
                <div style="width: 8px; height: 8px; border-radius: 50%; background-color: #3f3f46; margin-top: 7px; flex-shrink: 0;"></div>
                <p style="font-size: 18px; line-height: 1.45;">
                  <span style="color: #a1a1aa; font-weight: 400;">{p.lead} </span>
                  <span style="color: #ffffff; font-weight: 600;">{p.key}</span>
                </p>
              </div>
            ))}
          </div>
        </div>

        <a
          href="/about-us"
          style="
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background-color: #ffffff;
            color: #09090b;
            font-size: 15px;
            font-weight: 500;
            padding: 12px 20px;
            border-radius: 36px;
            text-decoration: none;
            width: fit-content;
            border: 1px solid #3f3f46;
            transition: opacity 0.2s ease;
          "
          onmouseover="this.style.opacity='0.85'"
          onmouseout="this.style.opacity='1'"
        >
          More About Us →
        </a>
      </div>

      <!-- Right: Light Surface Card -->
      <div
        class="reveal-right"
        style="background-color: #ffffff; border-radius: 36px; padding: 48px 40px; border: 1px solid #ececee; box-shadow: rgb(228,228,231) 0px 1px 0px 0px inset;"
      >
        <h2 style="font-size: 40px; font-weight: 700; color: #09090b; line-height: 1.25; margin-bottom: 24px;">
          Our Core Services
        </h2>

        <h3 style="font-size: 18px; font-weight: 600; color: #18181b; margin-bottom: 16px;">
          Accounting, Marketing & Development
        </h3>

        <p style="font-size: 15px; font-weight: 400; color: #71717a; line-height: 1.6; margin-bottom: 14px;">
          Our accounting services help maintain clarity in bookkeeping, reporting, compliance, and financial planning so your numbers stay accurate and actionable.
        </p>

        <p style="font-size: 15px; font-weight: 400; color: #71717a; line-height: 1.6; margin-bottom: 14px;">
          Our digital marketing team focuses on brand visibility, audience growth, and performance-driven campaigns that support stronger engagement and measurable results.
        </p>

        <p style="font-size: 15px; font-weight: 400; color: #71717a; line-height: 1.6; margin-bottom: 28px;">
          Our software development services turn business requirements into reliable digital products, from internal tools and automation to scalable web and mobile solutions.
        </p>

        <a
          href="/products"
          style="font-size: 15px; font-weight: 600; color: #09090b; text-decoration: none; border-bottom: 1.5px solid #09090b; padding-bottom: 2px; transition: opacity 0.2s ease;"
          onmouseover="this.style.opacity='0.6'"
          onmouseout="this.style.opacity='1'"
        >
          Explore Our Services →
        </a>
      </div>

    </div>
  </div>
</section>
