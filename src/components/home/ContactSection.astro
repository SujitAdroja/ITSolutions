---
import { Image } from 'astro:assets';
import contactImg from '../../assets/contact/contact.png';
---

<section class="section bg-bg-alt">
  <div class="container-x">

    <div class="reveal mx-auto mb-10 max-w-2xl text-center md:mb-12">
      <span class="eyebrow">Get In Touch</span>
      <h2 class="h-section mt-4">Ready to Get <span class="text-gradient">Started?</span></h2>
      <p class="lead mt-4">Send us a message and we'll get back to you shortly.</p>
    </div>

    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16">

      <!-- Illustration -->
      <div class="reveal-left hidden justify-center lg:flex">
        <div class="relative w-full max-w-md">
          <div aria-hidden="true" class="absolute inset-8 rounded-full bg-brand/15 blur-3xl"></div>
          <Image
            src={contactImg}
            alt="Get in touch illustration"
            class="relative h-auto w-full object-contain"
            format="webp"
            widths={[448, 750]}
            sizes="448px"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>

      <!-- Form -->
      <div class="reveal-right card p-6 sm:p-8">
        <form
          class="flex flex-col gap-3"
          action="https://formsubmit.co/runa@echoeleganceltd.uk"
          method="POST"
        >
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <input type="text" name="name" placeholder="Your name" class="input" required />
            <input type="email" name="email" placeholder="Your email address" class="input" required />
          </div>
          <input type="tel" name="mobile" placeholder="Your mobile number" class="input" />
          <textarea name="message" placeholder="Write your message..." rows="4" class="input resize-none" required></textarea>

          <button type="submit" class="btn-primary mt-2 w-full sm:w-auto">
            Send Message
            <svg class="arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
        </form>
      </div>

    </div>
  </div>
</section>
