---

---

<section style="background-color: #f4f4f5; padding: 80px 0;">
  <div class="max-w-[1200px] mx-auto px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center reveal" style="margin-bottom: 48px;">
      <span style="
        background-color: #3f3f46;
        color: #fafafa;
        border-radius: 12px;
        padding: 4px 10px;
        font-size: 12px;
        font-weight: 500;
        display: inline-block;
        margin-bottom: 16px;
      ">
        Get In Touch
      </span>
      <h2 style="font-size: 40px; font-weight: 700; color: #09090b; line-height: 1.25; margin-bottom: 8px;">
        Ready to Get <span style="color: #2563eb;">Started?</span>
      </h2>
      <p style="font-size: 16px; font-weight: 400; color: #71717a; line-height: 1.5;">
        Send us a message and we'll get back to you shortly.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

      <!-- Left: Illustration -->
      <div class="flex justify-center reveal-left">
        <img
          src="/contact/contact.png"
          alt="Get In Touch Illustration"
          style="width: 100%; max-width: 440px; height: 380px; object-fit: contain;"
        />
      </div>

      <!-- Right: Form -->
      <div class="reveal-right">
        <form
          style="display: flex; flex-direction: column; gap: 12px;"
          action="https://formsubmit.co/bonebreaker712003@gmail.com"
          method="POST"
        >
          <input
            type="text"
            name="name"
            placeholder="Your name"
            style="width: 100%; background-color: #ffffff; border: none; border-radius: 14px; padding: 12px 16px; font-size: 14px; color: #18181b; outline: none;"
          />
          <input
            type="email"
            name="email"
            placeholder="Your email address"
            style="width: 100%; background-color: #ffffff; border: none; border-radius: 14px; padding: 12px 16px; font-size: 14px; color: #18181b; outline: none;"
          />
          <input
            type="tel"
            name="mobile"
            placeholder="Your mobile number"
            style="width: 100%; background-color: #ffffff; border: none; border-radius: 14px; padding: 12px 16px; font-size: 14px; color: #18181b; outline: none;"
          />
          <textarea
            name="message"
            placeholder="Write your message..."
            rows="4"
            style="width: 100%; background-color: #ffffff; border: none; border-radius: 14px; padding: 12px 16px; font-size: 14px; color: #18181b; outline: none; resize: none;"
          ></textarea>

          <div style="margin-top: 4px;">
            <button
              type="submit"
              style="
                display: inline-flex;
                align-items: center;
                gap: 8px;
                background-color: #09090b;
                color: #ffffff;
                font-size: 15px;
                font-weight: 500;
                padding: 12px 24px;
                border-radius: 36px;
                border: none;
                cursor: pointer;
                box-shadow:
                  rgba(255,255,255,0.5) 0px 0.5px 0px 0px inset,
                  rgba(117,123,133,0.4) 0px 9px 14px -5px inset,
                  rgb(44,46,52) 0px 0px 0px 1.5px,
                  rgba(0,0,0,0.14) 0px 4px 6px 0px;
                transition: opacity 0.2s ease;
              "
              onmouseover="this.style.opacity='0.88'"
              onmouseout="this.style.opacity='1'"
            >
              Send Message →
            </button>
          </div>
        </form>
      </div>

    </div>
  </div>
</section>
