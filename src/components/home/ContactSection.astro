---

---

<section class="py-16 lg:py-20" style="background-color: #f0f9fc;">
  <div class="max-w-6xl mx-auto px-6">
    <div
      class="flex items-center justify-center gap-4 text-orange-500 text-md font-semibold uppercase tracking-widest mb-3 reveal"
    >
      <img src="/homepage/star-icon.png" alt="start icon image" class="animate-spin-slow md:scale-130">
      Get In Touch
    </div>
    <div class="reveal">
      <h2 class="text-center text-3xl lg:text-4xl font-black text-gray-900 mb-1">
      Ready to Get Started?
    </h2>
    <p class="text-center text-gray-400 text-md mb-8">
      Your email address will not be published.
    </p>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center reveal-left">
      <!-- Left: Illustration -->
      <div class="flex justify-center">
        <img
          src="/contact/contact.png"
          alt="Get In Touch Illustration"
          class="w-full max-w-xl h-100 object-contain bg-transparent"
        />
      </div>

      <!-- Right: Form -->
      <div >
        <form class="flex flex-col gap-4 reveal md:reveal-right"  action="https://formsubmit.co/bonebreaker712003@gmail.com" method="POST">
          <input
            type="text"
            name="name"
            placeholder="Your name"
            class="w-full bg-white border border-gray-200 rounded-lg px-4 py-3 text-sm text-gray-700 placeholder-gray-400 outline-none focus:border-orange-400 focus:ring-1 focus:ring-orange-300 transition"
          />

          <input
            type="email"
            name="email"
            placeholder="Your email address"
            class="w-full bg-white border border-gray-200 rounded-lg px-4 py-3 text-sm text-gray-700 placeholder-gray-400 outline-none focus:border-orange-400 focus:ring-1 focus:ring-orange-300 transition"
          />

          <input
            type="tel"
            name="mobile"
            placeholder="Your Mobile number"
            class="w-full bg-white border border-gray-200 rounded-lg px-4 py-3 text-sm text-gray-700 placeholder-gray-400 outline-none focus:border-orange-400 focus:ring-1 focus:ring-orange-300 transition"
          />

          <textarea
            name="message"
            placeholder="Write your message..."
            rows="4"
            class="w-full bg-white border border-gray-200 rounded-lg px-4 py-3 text-sm text-gray-700 placeholder-gray-400 outline-none focus:border-orange-400 focus:ring-1 focus:ring-orange-300 transition resize-none"
          ></textarea>

          <div>
            <button
              type="submit"
          class="cta-btn inline-flex items-center gap-3 bg-orange-500 text-white font-semibold px-4 py-2 md:px-6 md:py-3 rounded-md overflow-hidden"
            >
              Send Message
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>
