---
const testimonials = [
  {
    text: "The accounting support helped us bring structure to monthly closing and reporting. We now catch issues earlier and the team spends less time reconciling data.",
    name: "Meera Joshi",
    role: "Finance Lead",
  },
  {
    text: "Their marketing guidance gave us a clearer campaign direction and better lead quality. The reporting is easier to understand and the decisions feel more grounded.",
    name: "Arjun Mehta",
    role: "Marketing Manager",
  },
  {
    text: "The development team translated our requirements into a clean, reliable application. The project stayed on schedule and the handoff was straightforward.",
    name: "Ritika Shah",
    role: "Product Owner",
  },
  {
    text: "We needed better bookkeeping discipline and they delivered a practical process that our staff could actually follow. That alone saved us a lot of time each month.",
    name: "Kunal Verma",
    role: "Director",
  },
  {
    text: "Our marketing campaigns became more consistent once the strategy and tracking were fixed. We can now see what is working instead of guessing.",
    name: "Sana Khan",
    role: "Brand Manager",
  },
  {
    text: "The development support has been responsive and practical from start to finish. Small changes no longer slow the project down and the codebase feels more maintainable.",
    name: "Dev Patel",
    role: "CTO",
  },
];

const desktopGroups: (typeof testimonials)[] = [];
for (let i = 0; i < testimonials.length; i += 2) {
  desktopGroups.push(testimonials.slice(i, i + 2));
}

const initials = (name: string) =>
  name.split(' ').map((n) => n[0]).join('').slice(0, 2).toUpperCase();
---

<section class="section bg-bg">
  <div class="container-x">

    <div class="reveal mx-auto mb-10 max-w-2xl text-center md:mb-12">
      <span class="eyebrow">Testimonials</span>
      <h2 class="h-section mt-4">What Our Clients <span class="text-gradient">are Saying</span></h2>
      <p class="lead mt-4">
        We pride ourselves on providing an exceptional service — but don't just take our word for it.
      </p>
    </div>

    <!-- Mobile / tablet: single card slider -->
    <div class="lg:hidden" x-data="{
      current: 0,
      total: 6,
      next() { this.current = (this.current + 1) % this.total; },
      prev() { this.current = this.current === 0 ? this.total - 1 : this.current - 1; },
      init() { setInterval(() => { this.next(); }, 6000); }
    }" x-init="init()">
      <div class="overflow-hidden rounded-3xl">
        <div class="flex transition-transform duration-700 ease-in-out" :style="`transform: translateX(-${current * 100}%);`">
          {testimonials.map((item) => (
            <div class="w-full shrink-0 px-0.5">
              <article class="card flex min-h-[220px] flex-col p-7">
                <svg class="mb-4 text-brand" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7.17 6A5.17 5.17 0 0 0 2 11.17V18h6.5v-6.5H5.4A3.1 3.1 0 0 1 8.5 8.4V6H7.17Zm10 0A5.17 5.17 0 0 0 12 11.17V18h6.5v-6.5h-3.1a3.1 3.1 0 0 1 3.1-3.1V6h-1.33Z"/></svg>
                <p class="flex-1 text-[15px] leading-relaxed text-muted">{item.text}</p>
                <footer class="mt-6 flex items-center gap-3">
                  <span class="flex size-10 items-center justify-center rounded-full bg-brand-soft text-sm font-bold text-brand">{initials(item.name)}</span>
                  <div>
                    <p class="text-sm font-semibold text-fg">{item.name}</p>
                    <p class="text-xs text-muted">{item.role}</p>
                  </div>
                </footer>
              </article>
            </div>
          ))}
        </div>
      </div>

      <div class="mt-6 flex items-center justify-center gap-4">
        <button @click="prev()" class="testi-arrow-btn" aria-label="Previous testimonial">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
        </button>
        <div class="flex items-center gap-1.5">
          <template x-for="(_, index) in total">
            <button @click="current = index" class="testi-dot" :class="current === index && 'testi-dot--active'" :aria-label="`Go to testimonial ${index + 1}`"></button>
          </template>
        </div>
        <button @click="next()" class="testi-arrow-btn" aria-label="Next testimonial">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>

    <!-- Desktop: 2-column slider -->
    <div class="hidden lg:block" x-data="{
      current: 0,
      total: 3,
      next() { this.current = (this.current + 1) % this.total; },
      prev() { this.current = this.current === 0 ? this.total - 1 : this.current - 1; },
      init() { setInterval(() => { this.next(); }, 6000); }
    }" x-init="init()">
      <div class="overflow-hidden rounded-3xl">
        <div class="flex transition-transform duration-700 ease-in-out" :style="`transform: translateX(-${current * 100}%);`">
          {desktopGroups.map((group) => (
            <div class="w-full shrink-0 px-0.5">
              <div class="grid grid-cols-2 gap-5">
                {group.map((item) => (
                  <article class="card flex flex-col p-8">
                    <svg class="mb-4 text-brand" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7.17 6A5.17 5.17 0 0 0 2 11.17V18h6.5v-6.5H5.4A3.1 3.1 0 0 1 8.5 8.4V6H7.17Zm10 0A5.17 5.17 0 0 0 12 11.17V18h6.5v-6.5h-3.1a3.1 3.1 0 0 1 3.1-3.1V6h-1.33Z"/></svg>
                    <p class="min-h-[110px] flex-1 text-[15px] leading-relaxed text-muted">{item.text}</p>
                    <footer class="mt-6 flex items-center gap-3">
                      <span class="flex size-10 items-center justify-center rounded-full bg-brand-soft text-sm font-bold text-brand">{initials(item.name)}</span>
                      <div>
                        <p class="text-sm font-semibold text-fg">{item.name}</p>
                        <p class="text-xs text-muted">{item.role}</p>
                      </div>
                    </footer>
                  </article>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="mt-8 flex items-center justify-center gap-4">
        <button @click="prev()" class="testi-arrow-btn" aria-label="Previous testimonials">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
        </button>
        <div class="flex items-center gap-1.5">
          <template x-for="(_, index) in total">
            <button @click="current = index" class="testi-dot" :class="current === index && 'testi-dot--active'" :aria-label="`Go to slide ${index + 1}`"></button>
          </template>
        </div>
        <button @click="next()" class="testi-arrow-btn" aria-label="Next testimonials">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>

  </div>
</section>

<style>
  .testi-arrow-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--fg);
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .testi-arrow-btn:hover {
    background: var(--brand);
    border-color: var(--brand);
    color: #fff;
  }
  .testi-dot {
    width: 7px;
    height: 7px;
    border: none;
    border-radius: 999px;
    background: var(--line-strong);
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .testi-dot--active {
    width: 22px;
    background: var(--brand);
  }
</style>
