---
const testimonialGroups = [
  [
    {
      text: "I just wanted to share a quick note and let you know that you guys do a really good job...",
      name: "Tejas Agrawal",
      title: "Director of Radhe Dairy Products",
      avatar: "/homepage/img1 (1).jpg",
    },
    {
      text: "We have started working with Shahastra Solutions since the COVID-19 pandemic...",
      name: "Gaurav Doshi",
      title: "Director of Taralac",
      avatar: "/homepage/img2 (1).jpg",
    },
  ],

  [
    {
      text: "Shahastra team delivered the project on time and exceeded expectations.",
      name: "John Smith",
      title: "CEO",
      avatar: "/homepage/img4 (1).jpg",
    },
    {
      text: "Very professional team with excellent communication.",
      name: "Sarah Johnson",
      title: "Managing Director",
      avatar: "/homepage/img3 (1).jpg",
    },
  ],
];
---

<section
  class="bg-[#eef6fa] py-24 overflow-hidden"
  x-data="{
    current: 0,
    total: 2,

    next() {
      this.current = (this.current + 1) % this.total;
    },

    prev() {
      this.current =
        this.current === 0
          ? this.total - 1
          : this.current - 1;
    },

    init() {
      setInterval(() => {
        this.next();
      }, 6000);
    }
  }"
  x-init="init()"
>
  <div class="max-w-[1400px] mx-auto px-6">

    <!-- Header -->
    <div class="text-center mb-20">

      <div class="flex justify-center items-center gap-2 text-[#ff6b1a] uppercase font-semibold text-sm mb-5">
        <img
          src="/homepage/star-icon.png"
          class="w-5 h-5 animate-spin-slow"
          alt=""
        />
        Testimonials
      </div>

      <h2 class="text-4xl font-bold text-[#232323] mb-5">
        What Our Clients are Saying?
      </h2>

      <p class="max-w-4xl mx-auto text-[#6d6d6d] text-lg leading-relaxed">
        We pride ourselves on providing an exceptional service
        to our clients, but you don't just have to take our word for it.
      </p>

    </div>

    <!-- Navigation Buttons -->
    <div class="flex justify-between items-center mb-8">

      <button
        @click="prev()"
        class="w-14 h-14 rounded-full border border-[#d9d9d9] bg-white hover:bg-[#ff6b1a] hover:text-white transition-all duration-300"
      >
        ←
      </button>

      <button
        @click="next()"
        class="w-14 h-14 rounded-full border border-[#d9d9d9] bg-white hover:bg-[#ff6b1a] hover:text-white transition-all duration-300"
      >
        →
      </button>

    </div>

    <!-- Slider -->
    <div class="overflow-hidden">

      <div
        class="flex transition-transform duration-700 ease-in-out"
        :style="`transform: translateX(-${current * 100}%);`"
      >

        {
          testimonialGroups.map((group) => (
            <div class="w-full shrink-0">

              <div class="grid lg:grid-cols-2 gap-8">

                {
                  group.map((item) => (
                    <div class="relative bg-white min-h-[450px] p-14 flex flex-col justify-between rounded-sm">

                      <!-- Quote Mark -->
                      <div class="absolute top-4 left-1/2 -translate-x-1/2 text-[180px] text-gray-100 leading-none select-none">
                        “
                      </div>

                      <p class="relative z-10 text-center text-[#6d6d6d] text-[20px] leading-[2] mt-16">
                        {item.text}
                      </p>

                      <div class="relative z-10 flex items-center justify-center gap-4 mt-12">

                        <img
                          src={item.avatar}
                          alt={item.name}
                          class="w-16 h-16 rounded-full object-cover"
                        />

                        <div>

                          <h4 class="font-bold text-2xl text-[#232323]">
                            {item.name}
                          </h4>

                          <p class="text-[#6d6d6d]">
                            {item.title}
                          </p>

                        </div>

                      </div>

                    </div>
                  ))
                }

              </div>

            </div>
          ))
        }

      </div>

    </div>

    <!-- Dots -->
    <div class="flex justify-center gap-3 mt-10">

      <template x-for="(item,index) in total">

        <button
          @click="current=index"
          class="w-3 h-3 rounded-full transition-all"
          :class="current === index ? 'bg-[#ff6b1a] w-8' : 'bg-gray-300'"
        ></button>

      </template>

    </div>

  </div>
</section>

<style>
  @keyframes spin-slow {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .animate-spin-slow {
    animation: spin-slow 12s linear infinite;
  }
</style>