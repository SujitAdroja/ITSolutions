---
const testimonials = [
  {
    text: "The accounting support helped us bring structure to monthly closing and reporting. We now catch issues earlier and the team spends less time reconciling data.",
    name: "Meera Joshi",
  },
  {
    text: "Their marketing guidance gave us a clearer campaign direction and better lead quality. The reporting is easier to understand and the decisions feel more grounded.",
    name: "Arjun Mehta",
  },
  {
    text: "The development team translated our requirements into a clean, reliable application. The project stayed on schedule and the handoff was straightforward.",
    name: "Ritika Shah",
  },
  {
    text: "We needed better bookkeeping discipline and they delivered a practical process that our staff could actually follow. That alone saved us a lot of time each month.",
    name: "Kunal Verma",
  },
  {
    text: "Our marketing campaigns became more consistent once the strategy and tracking were fixed. We can now see what is working instead of guessing.",
    name: "Sana Khan",
  },
  {
    text: "The development support has been responsive and practical from start to finish. Small changes no longer slow the project down and the codebase feels more maintainable.",
    name: "Dev Patel",
  },
];

const desktopGroups: (typeof testimonials)[] = [];
for (let i = 0; i < testimonials.length; i += 2) {
  desktopGroups.push(testimonials.slice(i, i + 2));
}
---

<section style="background-color: #f4f4f5; padding: 80px 0;">
  <div class="max-w-[1200px] mx-auto px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center reveal" style="margin-bottom: 48px;">
      <span style="
        background-color: #3f3f46;
        color: #fafafa;
        border-radius: 12px;
        padding: 4px 10px;
        font-size: 12px;
        font-weight: 500;
        display: inline-block;
        margin-bottom: 16px;
      ">
        Testimonials
      </span>
      <h2 style="font-size: 40px; font-weight: 700; color: #09090b; line-height: 1.25; margin-bottom: 12px;">
        What Our Clients <span style="color: #2563eb;">are Saying</span>
      </h2>
      <p style="font-size: 16px; font-weight: 400; color: #71717a; line-height: 1.5; max-width: 520px; margin: 0 auto;">
        We pride ourselves on providing an exceptional service — but don't just take our word for it.
      </p>
    </div>

    <!-- Mobile: single card slider -->
    <div class="lg:hidden" x-data="{
      current: 0,
      total: 6,
      next() { this.current = (this.current + 1) % this.total; },
      prev() { this.current = this.current === 0 ? this.total - 1 : this.current - 1; },
      init() { setInterval(() => { this.next(); }, 6000); }
    }" x-init="init()">
      <div style="overflow: hidden; border-radius: 36px;">
        <div class="flex transition-transform duration-700 ease-in-out" :style="`transform: translateX(-${current * 100}%);`">
          {testimonials.map((item) => (
            <div style="width: 100%; flex-shrink: 0; padding: 0 2px;">
              <article style="background-color: #ffffff; border-radius: 36px; padding: 28px; border: 1px solid #ececee; box-shadow: rgb(228,228,231) 0px 1px 0px 0px inset; min-height: 200px;">
                <p style="font-size: 15px; font-weight: 400; color: #71717a; line-height: 1.6; margin-bottom: 20px;">
                  "{item.text}"
                </p>
                <p style="font-size: 15px; font-weight: 600; color: #09090b;">{item.name}</p>
              </article>
            </div>
          ))}
        </div>
      </div>

      <!-- Mobile nav row -->
      <div style="display: flex; align-items: center; justify-content: center; gap: 16px; margin-top: 24px;">
        <button @click="prev()" class="testi-arrow-btn" aria-label="Previous">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5M12 5l-7 7 7 7"/>
          </svg>
        </button>

        <div style="display: flex; gap: 6px; align-items: center;">
          <template x-for="(_, index) in total">
            <button
              @click="current = index"
              style="height: 7px; border-radius: 10000px; border: none; cursor: pointer; transition: all 0.3s ease; background-color: #d4d4d8;"
              :style="current === index ? 'background-color: #09090b; width: 22px;' : 'background-color: #d4d4d8; width: 7px;'"
            ></button>
          </template>
        </div>

        <button @click="next()" class="testi-arrow-btn" aria-label="Next">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Desktop: 2-column slider -->
    <div class="hidden lg:block" x-data="{
      current: 0,
      total: 3,
      next() { this.current = (this.current + 1) % this.total; },
      prev() { this.current = this.current === 0 ? this.total - 1 : this.current - 1; },
      init() { setInterval(() => { this.next(); }, 6000); }
    }" x-init="init()">
      <div style="overflow: hidden; border-radius: 36px;">
        <div class="flex transition-transform duration-700 ease-in-out" :style="`transform: translateX(-${current * 100}%);`">
          {desktopGroups.map((group) => (
            <div style="width: 100%; flex-shrink: 0; padding: 0 2px;">
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                {group.map((item) => (
                  <article style="background-color: #ffffff; border-radius: 36px; padding: 28px; border: 1px solid #ececee; box-shadow: rgb(228,228,231) 0px 1px 0px 0px inset;">
                    <p style="font-size: 15px; font-weight: 400; color: #71717a; line-height: 1.6; margin-bottom: 20px; min-height: 120px;">
                      "{item.text}"
                    </p>
                    <p style="font-size: 15px; font-weight: 600; color: #09090b;">{item.name}</p>
                  </article>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Desktop nav row -->
      <div style="display: flex; align-items: center; justify-content: center; gap: 16px; margin-top: 24px;">
        <button @click="prev()" class="testi-arrow-btn" aria-label="Previous">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5M12 5l-7 7 7 7"/>
          </svg>
        </button>

        <div style="display: flex; gap: 6px; align-items: center;">
          <template x-for="(_, index) in total">
            <button
              @click="current = index"
              style="height: 7px; border-radius: 10000px; border: none; cursor: pointer; transition: all 0.3s ease;"
              :style="current === index ? 'background-color: #09090b; width: 22px;' : 'background-color: #d4d4d8; width: 7px;'"
            ></button>
          </template>
        </div>

        <button @click="next()" class="testi-arrow-btn" aria-label="Next">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
    </div>

  </div>
</section>

<style>
  .testi-arrow-btn {
    width: 40px;
    height: 40px;
    border-radius: 40px;
    border: 1px solid #d4d4d8;
    background: #ffffff;
    color: #09090b;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    flex-shrink: 0;
  }
  .testi-arrow-btn:hover {
    background: #09090b;
    border-color: #09090b;
    color: #ffffff;
  }
</style>
