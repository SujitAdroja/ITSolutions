---
const testimonialGroups = [
  [
    {
      text:
        "I just wanted to share a quick note and let you know that you guys do a really good job. I'm glad I decided to work with you. It's really great how easy your ERP and HRMS solutions are to update and manage.",
      name: "Tejas Agrawal",
      title: "Director of Radhe Dairy Products",
      avatar: "/homepage/img1 (1).jpg",
    },
    {
      text:
        "We have started working with Shahastra Solutions since the COVID-19 pandemic. Their products helped us increase business efficiency and manage customer relationships effectively.",
      name: "Gaurav Doshi",
      title: "Director of Taralac",
      avatar: "/homepage/img2 (1).jpg",
    },
  ],

  [
    {
      text:
        "Shahastra team delivered the project on time and exceeded expectations. Their support and communication throughout the project were exceptional.",
      name: "John Smith",
      title: "CEO",
      avatar: "/homepage/img4 (1).jpg",
    },
    {
      text:
        "Very professional team with excellent communication. They understand business requirements and transform them into quality software solutions.",
      name: "Sarah Johnson",
      title: "Managing Director",
      avatar: "/homepage/img3 (1).jpg",
    },
  ],
];
---

<section
  class="bg-[#eef6fa] py-16 md:py-20 lg:py-24 overflow-hidden"
  x-data="{
    current: 0,
    total: 2,

    next() {
      this.current = (this.current + 1) % this.total;
    },

    prev() {
      this.current =
        this.current === 0
          ? this.total - 1
          : this.current - 1;
    },

    init() {
      setInterval(() => {
        this.next();
      }, 6000);
    }
  }"
  x-init="init()"
>

  <div class="max-w-[1400px] mx-auto px-6">

    <!-- Header -->

    <div class="text-center mb-16 lg:mb-20">

      <div
        class="flex justify-center items-center gap-2 text-[#ff6b1a] uppercase font-semibold text-sm mb-5 reveal"
      >
        <img
          src="/homepage/star-icon.png"
          alt=""
          class="w-5 h-5 animate-spin-slow"
        />

        Testimonials
      </div>

      <div class="reveal">

        <h2
          class="text-3xl md:text-4xl lg:text-5xl font-bold text-[#232323] mb-5"
        >
          What Our Clients are Saying?
        </h2>

        <p
          class="max-w-4xl mx-auto text-[#6d6d6d] text-base md:text-lg leading-relaxed"
        >
          We pride ourselves on providing an exceptional service
          to our clients, but you don't just have to take our word
          for it.
        </p>

      </div>

    </div>

    <!-- Navigation -->

    <div
      class="flex justify-center lg:justify-between items-center gap-4 mb-10"
    >

      <button
        @click="prev()"
        class="w-12 h-12 md:w-14 md:h-14 rounded-full border border-[#d9d9d9] bg-white hover:bg-[#ff6b1a] hover:text-white transition-all duration-300 reveal-left"
      >
        ←
      </button>

      <button
        @click="next()"
        class="w-12 h-12 md:w-14 md:h-14 rounded-full border border-[#d9d9d9] bg-white hover:bg-[#ff6b1a] hover:text-white transition-all duration-300 reveal-right"
      >
        →
      </button>

    </div>

    <!-- Slider -->

    <div class="overflow-hidden reveal">

      <div
        class="flex transition-transform duration-700 ease-in-out"
        :style="`transform: translateX(-${current * 100}%);`"
      >

        {
          testimonialGroups.map((group) => (
            <div class="w-full shrink-0">

              <div
                class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8"
              >

                {
                  group.map((item) => (
                    <div
                      class="relative bg-white rounded-lg p-6 md:p-8 lg:p-12 shadow-sm hover:shadow-xl transition-all duration-300"
                    >

                      <!-- Quote -->

                      <div
                        class="absolute top-2 md:top-4 left-1/2 -translate-x-1/2 text-[80px] md:text-[120px] lg:text-[180px] text-gray-100 leading-none select-none"
                      >
                        "
                      </div>

                      <!-- Content -->

                      <p
                        class="relative z-10 text-center text-[#6d6d6d] text-sm md:text-base lg:text-lg leading-7 md:leading-8 mt-10 md:mt-16 min-h-[180px] md:min-h-[220px]"
                      >
                        {item.text}
                      </p>

                      <!-- User -->

                      <div
                        class="relative z-10 flex flex-col sm:flex-row items-center justify-center gap-4 mt-8 md:mt-10"
                      >

                        <img
                          src={item.avatar}
                          alt={item.name}
                          class="w-14 h-14 md:w-16 md:h-16 rounded-full object-cover"
                        />

                        <div class="text-center sm:text-left">

                          <h4
                            class="font-bold text-lg md:text-xl text-[#232323]"
                          >
                            {item.name}
                          </h4>

                          <p
                            class="text-sm text-[#6d6d6d]"
                          >
                            {item.title}
                          </p>

                        </div>

                      </div>

                    </div>
                  ))
                }

              </div>

            </div>
          ))
        }

      </div>

    </div>

    <!-- Dots -->

    <div
      class="flex justify-center gap-3 mt-10"
    >

      <template x-for="(_, index) in total">

        <button
          @click="current = index"
          class="h-3 rounded-full transition-all duration-300"
          :class="current === index ? 'bg-[#ff6b1a] w-8' : 'bg-gray-300 w-3'"
        ></button>

      </template>

    </div>

  </div>

</section>

<style>
  @keyframes spin-slow {
    from {
      transform: rotate(0deg);
    }

    to {
      transform: rotate(360deg);
    }
  }

  .animate-spin-slow {
    animation: spin-slow 12s linear infinite;
  }
</style>