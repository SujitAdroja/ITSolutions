---
const areas = [
  { label: 'Textile', imgPath: '/homepage/textile.jpg' },
  { label: 'Manufacturing & Engineering', imgPath: '/homepage/manufacturing-engineering.jpg' },
  { label: 'E-Commerce', imgPath: '/homepage/ecommerce.jpg' },
  { label: 'Real Estate', imgPath: '/homepage/real-estate.jpg' },
  { label: 'Advertising & Marketing', imgPath: '/homepage/advertising-marketing.jpg' },
  { label: 'Transport & Logistics', imgPath: '/homepage/transports-logistics.jpg' },
  { label: 'Retail & FMCG', imgPath: '/homepage/retailmarket.jpg' },
  { label: 'Chemical & Paint', imgPath: '/homepage/chemical-paint.jpg' },
  { label: 'Healthcare', imgPath: '/homepage/healthcare.jpg' },
  { label: 'FinTech', imgPath: '/homepage/fintech.jpg' },
  { label: 'PropTech', imgPath: '/homepage/proptech.jpg' },
  { label: 'EducationTech', imgPath: '/homepage/educationtech.jpg' },
  { label: 'Crypto & Blockchain', imgPath: '/homepage/crypto-blockchain.jpg' },
  { label: 'SaaS & Enterprise', imgPath: '/homepage/saas-enterprise.jpg' },
];
---

<section class="section bg-bg-alt">
  <div class="container-x">

    <div class="reveal mx-auto mb-10 max-w-2xl text-center md:mb-12">
      <span class="eyebrow">Industries</span>
      <h2 class="h-section mt-4">Work <span class="text-gradient">Areas</span></h2>
      <p class="lead mt-4">
        Every industry faces relentless change. We provide high-quality service and support across sectors.
      </p>
    </div>

    <div class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4">
      {areas.map((area) => (
        <figure class="area-card group reveal relative overflow-hidden rounded-2xl border border-line bg-surface shadow-card md:rounded-3xl">
          <img
            src={area.imgPath}
            alt={`${area.label} industry solutions`}
            class="h-36 w-full object-cover transition duration-500 group-hover:scale-105 sm:h-44 lg:h-52"
            width="900"
            height="600"
            loading="lazy"
            decoding="async"
          />
          <!-- gradient overlay for legibility -->
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-t from-navy/80 via-navy/20 to-transparent"></div>
          <figcaption class="absolute inset-x-0 bottom-0 p-3 sm:p-4">
            <span class="inline-block rounded-full bg-white/90 px-3 py-1.5 text-xs font-semibold text-navy backdrop-blur transition group-hover:bg-brand group-hover:text-white sm:text-sm dark:bg-white/85">
              {area.label}
            </span>
          </figcaption>
        </figure>
      ))}
    </div>

  </div>
</section>
