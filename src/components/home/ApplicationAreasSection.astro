---
import { Image } from 'astro:assets';
import textile from '../../assets/homepage/areas/textile.jpg';
import manufacturing from '../../assets/homepage/areas/manufacturing-engineering.jpg';
import ecommerce from '../../assets/homepage/areas/ecommerce.jpg';
import realEstate from '../../assets/homepage/areas/real-estate.jpg';
import advertising from '../../assets/homepage/areas/advertising-marketing.jpg';
import transport from '../../assets/homepage/areas/transports-logistics.jpg';
import retail from '../../assets/homepage/areas/retailmarket.jpg';
import chemical from '../../assets/homepage/areas/chemical-paint.jpg';
import healthcare from '../../assets/homepage/areas/healthcare.jpg';
import fintech from '../../assets/homepage/areas/fintech.jpg';
import proptech from '../../assets/homepage/areas/proptech.jpg';
import educationtech from '../../assets/homepage/areas/educationtech.jpg';
import crypto from '../../assets/homepage/areas/crypto-blockchain.jpg';
import saas from '../../assets/homepage/areas/saas-enterprise.jpg';

const areas = [
  { label: 'Textile', img: textile },
  { label: 'Manufacturing & Engineering', img: manufacturing },
  { label: 'E-Commerce', img: ecommerce },
  { label: 'Real Estate', img: realEstate },
  { label: 'Advertising & Marketing', img: advertising },
  { label: 'Transport & Logistics', img: transport },
  { label: 'Retail & FMCG', img: retail },
  { label: 'Chemical & Paint', img: chemical },
  { label: 'Healthcare', img: healthcare },
  { label: 'FinTech', img: fintech },
  { label: 'PropTech', img: proptech },
  { label: 'EducationTech', img: educationtech },
  { label: 'Crypto & Blockchain', img: crypto },
  { label: 'SaaS & Enterprise', img: saas },
];

// Card is 2-up on mobile, 3-up on md, 4-up on lg; height-capped, so ~300–450px is plenty
const cardSizes = '(min-width: 1024px) 300px, (min-width: 768px) 33vw, 50vw';
---

<section class="section bg-bg-alt">
  <div class="container-x">

    <div class="reveal mx-auto mb-10 max-w-2xl text-center md:mb-12">
      <span class="eyebrow">Industries</span>
      <h2 class="h-section mt-4">Work <span class="text-gradient">Areas</span></h2>
      <p class="lead mt-4">
        Every industry faces relentless change. We provide high-quality service and support across sectors.
      </p>
    </div>

    <div class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4">
      {areas.map((area) => (
        <figure class="area-card group reveal relative overflow-hidden rounded-2xl border border-line bg-surface shadow-card md:rounded-3xl">
          <Image
            src={area.img}
            alt={`${area.label} industry solutions`}
            class="h-36 w-full object-cover transition duration-500 group-hover:scale-105 sm:h-44 lg:h-52"
            format="webp"
            widths={[320, 480, 640]}
            sizes={cardSizes}
            loading="lazy"
            decoding="async"
          />
          <!-- gradient overlay for legibility -->
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-t from-navy/80 via-navy/20 to-transparent"></div>
          <figcaption class="absolute inset-x-0 bottom-0 p-3 sm:p-4">
            <span class="inline-block rounded-full bg-white/90 px-3 py-1.5 text-xs font-semibold text-navy backdrop-blur transition group-hover:bg-brand group-hover:text-white sm:text-sm dark:bg-white/85">
              {area.label}
            </span>
          </figcaption>
        </figure>
      ))}
    </div>

  </div>
</section>
