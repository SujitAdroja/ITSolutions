---
const areas = [
  { label: 'Retail & FMCG',imgPath:'/homepage/retailmarket.jpg' },
  { label: 'E-Commerce',imgPath:'/homepage/ecommerce.jpg' },
  { label: 'Textile',imgPath:'/homepage/textile.jpg' },
  { label: 'Real Estate',imgPath:'/homepage/real-estate.jpg' },
  { label: 'Transport & Logistics',imgPath:'/homepage/transports-logistics.jpg' },
  { label: 'Manufacturing & Engineering',imgPath:'/homepage/manufacturing-engineering.jpg' },
  { label: 'Chemical & Paint',imgPath:'/homepage/chemical-paint.jpg' },
  { label: 'Advertising & Marketing',imgPath:'/homepage/advertising-marketing.jpg' },
];
---

<section class="relative py-16 lg:py-20">
  <img src="/homepage/black-bg.jpg" alt="Background" class="absolute -z-1 inset-0 w-full h-full object-cover ">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center mb-10">
      <h2 class="text-white text-3xl lg:text-4xl font-bold mb-4">Application Areas</h2>
      <p class="text-white text-md max-w-4xl mx-auto leading-relaxed">
        Every industry in every market is facing relentless change and challenges like Consumers, vendors,
        distribution channels, accounts, and Man Power. Here we provide high-quality service and support.
      </p>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
      {areas.map((area) => (
        <div class="relative group overflow-hidden rounded-lg cursor-pointer">
          <img
            src={area.imgPath}
            alt={area.label}
            class="w-full h-44 object-cover block"
          />
          <!-- Overlay -->
          <div class="bg-white text-black flex items-end justify-center py-2">
            <span class="text-black font-semibold text-lg text-center px-2">{area.label}</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
