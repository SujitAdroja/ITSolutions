---
const areas = [
  { label: 'Textile', imgPath: '/homepage/textile.jpg' },
  { label: 'Manufacturing & Engineering', imgPath: '/homepage/manufacturing-engineering.jpg' },
  { label: 'E-Commerce', imgPath: '/homepage/ecommerce.jpg' },
  { label: 'Real Estate', imgPath: '/homepage/real-estate.jpg' },
  { label: 'Advertising & Marketing', imgPath: '/homepage/advertising-marketing.jpg' },
  { label: 'Transport & Logistics', imgPath: '/homepage/transports-logistics.jpg' },
  { label: 'Retail & FMCG', imgPath: '/homepage/retailmarket.jpg' },
  { label: 'Chemical & Paint', imgPath: '/homepage/chemical-paint.jpg' },
];
---

<section style="background-color: #f4f4f5; padding: 80px 0;">
  <div class="max-w-[1200px] mx-auto px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center reveal" style="margin-bottom: 48px;">
      <h2 style="font-size: 40px; font-weight: 700; color: #09090b; line-height: 1.25; margin-bottom: 16px;">
        Work <span style="color: #a1a1aa;">Areas</span>
      </h2>
      <p style="font-size: 16px; font-weight: 400; color: #71717a; line-height: 1.5; max-width: 600px; margin: 0 auto;">
        Every industry faces relentless change. We provide high-quality service and support across sectors.
      </p>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      {areas.map((area) => (
        <div
          class="reveal"
          style="position: relative; overflow: hidden; border-radius: 36px; cursor: pointer;"
        >
          <img
            src={area.imgPath}
            alt={area.label}
            style="width: 100%; height: 200px; object-fit: cover; display: block;"
          />
          <!-- Dark overlay badge at bottom-left -->
          <div style="position: absolute; bottom: 14px; left: 14px;">
            <span style="
              background: transparent;
              color: #ffffff;
              border: 1px solid rgba(255,255,255,0.4);
              border-radius: 12px;
              padding: 4px 10px;
              font-size: 12px;
              font-weight: 500;
              backdrop-filter: blur(8px);
            ">
              {area.label}
            </span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
