---
const stats = [
  { value: '10+', label: 'Technologies' },
  { value: '15+', label: 'Team Members' },
  { value: '100%', label: 'Satisfaction Rate' },
  { value: '4+', label: 'Countries' },
];
---

<section style="background-color: #f4f4f5; padding: 64px 0;">
  <div class="max-w-[1200px] mx-auto px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
      {stats.map((stat, i) => (
        <div class="reveal" style="display: flex; flex-direction: column; gap: 4px;">
          <p style="font-size: 40px; font-weight: 700; color: #09090b; line-height: 1.25;">
            {stat.value}
          </p>
          <p style="font-size: 13px; font-weight: 400; color: #71717a; line-height: 1.56;">
            {stat.label}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
