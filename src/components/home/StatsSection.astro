---
const stats = [
  { value: '20+', label: 'Technologies' },
  { value: '50+', label: 'Staff Augmentation Developers Delivered' },
  { value: '100%', label: 'Satisfaction Rate' },
];
---

<section class="bg-bg py-14 md:py-16">
  <div class="container-x">
    <div class="grid grid-cols-1 gap-6 rounded-3xl border border-line bg-surface p-6 shadow-card sm:grid-cols-3 md:p-10">
      {stats.map((stat, i) => (
        <div class:list={['reveal flex flex-col gap-1 sm:px-6', i > 0 && 'sm:border-l sm:border-line']}>
          <p class="text-gradient text-4xl font-extrabold leading-none tracking-tight md:text-5xl">{stat.value}</p>
          <p class="mt-2 text-sm font-medium text-muted">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
