---
import OfficeMap from "./OfficeMap.tsx";
import { officeLocations } from "./contactData";
---

<section class="bg-bg-alt pb-16 md:pb-24">
  <div class="container-x">
    <div class="grid gap-6 lg:grid-cols-[300px_1fr]">

      <!-- Office list -->
      <div class="flex flex-col gap-4">
        <span class="eyebrow w-fit">{officeLocations.length > 1 ? `${officeLocations.length} Office Locations` : 'Our Office'}</span>

        {officeLocations.map((office) => (
          <article class="card reveal relative overflow-hidden p-5">
            <span aria-hidden="true" class="absolute inset-y-0 left-0 w-1" style="background: var(--brand-gradient);"></span>
            <div class="flex items-start gap-3 pl-2">
              <div class="icon-tile !size-10 !rounded-xl">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div>
                <h4 class="text-base font-semibold text-fg">{office.name}</h4>
                <p class="mt-1 text-sm leading-relaxed text-muted">{office.address}</p>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Map -->
      <div class="map-frame min-h-[360px] overflow-hidden rounded-3xl border border-line shadow-card">
        <OfficeMap client:only="react" />
      </div>

    </div>
  </div>
</section>

<style>
  .map-frame :global(.leaflet-container) {
    height: 100%;
    min-height: 360px;
  }
  @media (min-width: 1024px) {
    .map-frame :global(.leaflet-container) {
      min-height: 520px;
    }
  }
</style>
