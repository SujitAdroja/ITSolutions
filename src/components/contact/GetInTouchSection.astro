<section style="background-color: #f4f4f5; padding: 0 0 80px;">
  <div class="max-w-[1200px] mx-auto px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 items-center">

      <!-- Illustration -->
      <div class="flex justify-center reveal-left">
        <img
          src="/contact/contact.png"
          alt="Contact illustration"
          style="width: 100%; max-width: 480px; border-radius: 36px;"
        />
      </div>

      <!-- Form card -->
      <div
        class="reveal-right"
        style="background-color: #ffffff; border-radius: 36px; border: 1px solid #ececee; box-shadow: rgb(228,228,231) 0px 1px 0px 0px inset; padding: 36px;"
      >
        <h3 style="font-size: 32px; font-weight: 700; color: #09090b; line-height: 1.28; margin-bottom: 8px;">
          Send a Message
        </h3>
        <p style="font-size: 15px; font-weight: 400; color: #71717a; line-height: 1.6; margin-bottom: 28px;">
          Tell us about your project, question, or support request and our team will get back to you promptly.
        </p>

        <form
          style="display: flex; flex-direction: column; gap: 12px;"
          method="POST"
          action="https://formsubmit.co/bonebreaker712003@gmail.com"
        >
          <input
            type="text"
            placeholder="Your name"
            name="name"
            required
            style="width: 100%; background-color: #f4f4f5; border: none; border-radius: 14px; padding: 14px 16px; font-size: 14px; color: #18181b; outline: none;"
          />
          <input
            type="email"
            name="email"
            placeholder="Your email address"
            required
            style="width: 100%; background-color: #f4f4f5; border: none; border-radius: 14px; padding: 14px 16px; font-size: 14px; color: #18181b; outline: none;"
          />
          <input
            type="text"
            name="number"
            placeholder="Your mobile number"
            required
            style="width: 100%; background-color: #f4f4f5; border: none; border-radius: 14px; padding: 14px 16px; font-size: 14px; color: #18181b; outline: none;"
          />
          <textarea
            rows="5"
            name="message"
            placeholder="Write your message..."
            required
            style="width: 100%; background-color: #f4f4f5; border: none; border-radius: 14px; padding: 14px 16px; font-size: 14px; color: #18181b; outline: none; resize: none;"
          ></textarea>

          <button
            type="submit"
            style="
              display: inline-flex;
              align-items: center;
              justify-content: center;
              gap: 8px;
              background-color: #09090b;
              color: #ffffff;
              font-size: 15px;
              font-weight: 500;
              padding: 14px 24px;
              border-radius: 36px;
              border: none;
              cursor: pointer;
              width: 100%;
              box-shadow:
                rgba(255,255,255,0.5) 0px 0.5px 0px 0px inset,
                rgba(117,123,133,0.4) 0px 9px 14px -5px inset,
                rgb(44,46,52) 0px 0px 0px 1.5px,
                rgba(0,0,0,0.14) 0px 4px 6px 0px;
              transition: opacity 0.2s ease;
            "
            onmouseover="this.style.opacity='0.88'"
            onmouseout="this.style.opacity='1'"
          >
            Send Message →
          </button>
        </form>
      </div>

    </div>
  </div>
</section>

<script is:inline>
  var d = document, w = "https://tally.so/widgets/embed.js",
    v = function () {
      if (typeof Tally !== "undefined") { Tally.loadEmbeds(); }
      else { d.querySelectorAll("iframe[data-tally-src]:not([src])").forEach(function (e) { e.src = e.dataset.tallySrc; }); }
    };
  if (typeof Tally !== "undefined") { v(); }
  else if (d.querySelector('script[src="' + w + '"]') == null) {
    var s = d.createElement("script"); s.src = w; s.onload = v; s.onerror = v; d.body.appendChild(s);
  }
</script>
