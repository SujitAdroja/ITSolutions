---
import { Image } from 'astro:assets';
import contactImg from '../../assets/contact/contact.png';
---

<section class="section bg-bg-alt">
  <div class="container-x">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">

      <!-- Illustration -->
      <div class="reveal-left hidden justify-center lg:flex">
        <div class="relative w-full max-w-md">
          <div aria-hidden="true" class="absolute inset-8 rounded-full bg-brand/15 blur-3xl"></div>
          <Image
            src={contactImg}
            alt="Contact illustration"
            class="relative h-auto w-full object-contain"
            format="webp"
            widths={[448, 750]}
            sizes="448px"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>

      <!-- Form card -->
      <div class="reveal-right card p-6 sm:p-8 md:p-9">
        <h3 class="text-2xl font-bold text-fg md:text-3xl">Send a Message</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-muted">
          Tell us about your project, question, or support request and our team will get back to you promptly.
        </p>

        <form
          class="mt-7 flex flex-col gap-3"
          method="POST"
          action="https://formsubmit.co/runa@echoeleganceltd.uk"
        >
          <input type="text" placeholder="Your name" name="name" required class="input" />
          <input type="email" name="email" placeholder="Your email address" required class="input" />
          <input type="tel" name="number" placeholder="Your mobile number" required class="input" />
          <textarea rows="5" name="message" placeholder="Write your message..." required class="input resize-none"></textarea>

          <button type="submit" class="btn-primary mt-2 w-full">
            Send Message
            <svg class="arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
        </form>
      </div>

    </div>
  </div>
</section>
