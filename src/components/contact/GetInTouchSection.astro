<section class="pb-24">
  <div class="max-w-[1400px] mx-auto">
    <div class="text-center mb-14 reveal">
      <div class="flex items-center justify-center gap-4">
        <img
          src="/homepage/star-icon.png"
          alt="start icon image"
          class="animate-spin-slow"
        />
        <span class="uppercase text-[#ff6b1a] font-semibold">
          Get In Touch
        </span>
      </div>
      <p class="mt-4 text-[#6d6d6d] text-md">
        Your email address will not be published
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-20 items-center">
      <!-- Illustration -->
      <div>
        <div class="reveal">
          <img
            src="/contact/contact.png"
            alt=""
            class="w-full max-w-[600px] mx-auto"
          />
        </div>

        <p class="mt-4 text-[#6d6d6d] text-md">
          Your email address will not be published
        </p>
      </div>

      <!-- Form -->

      <div class="bg-white shadow-lg border border-[#ececec] p-10 reveal-right">
        <form class="space-y-5">
          <input
            type="text"
            placeholder="Your name"
            class="w-full h-16 px-5 bg-[#f8f8f8] border border-[#ececec]"
          />

          <input
            type="email"
            placeholder="Your email address"
            class="w-full h-16 px-5 bg-[#f8f8f8] border border-[#ececec]"
          />

          <input
            type="text"
            placeholder="Your Mobile number"
            class="w-full h-16 px-5 bg-[#f8f8f8] border border-[#ececec]"
          />

          <textarea
            rows="6"
            placeholder="Write your message..."
            class="w-full p-5 bg-[#f8f8f8] border border-[#ececec]"></textarea>

          <button
            type="submit"
            class="bg-[#ff6b1a] text-white px-10 py-4 rounded"
          >
            Send Message
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  var d = document,
    w = "https://tally.so/widgets/embed.js",
    v = function () {
      if (typeof Tally !== "undefined") {
        Tally.loadEmbeds();
      } else {
        d.querySelectorAll("iframe[data-tally-src]:not([src])").forEach(
          function (e) {
            e.src = e.dataset.tallySrc;
          },
        );
      }
    };

  if (typeof Tally !== "undefined") {
    v();
  } else if (d.querySelector('script[src="' + w + '"]') == null) {
    var s = d.createElement("script");
    s.src = w;
    s.onload = v;
    s.onerror = v;
    d.body.appendChild(s);
  }
</script>
