<section class="pb-24">
  <div class="max-w-[1400px] mx-auto">
     

    <div class="grid lg:grid-cols-2 gap-20 items-center">
      <!-- Illustration -->
      <div>
        <div class="reveal">
          <img
            src="/contact/contact.png"
            alt=""
            class="w-full max-w-[600px] mx-auto"
          />
        </div>

      </div>

      <!-- Form -->

      <div class="bg-white shadow-[0_20px_60px_rgba(17,17,26,0.08)] border border-[#ececec] rounded-lg p-6 md:p-10 reveal">
        <div class="mb-8">
          <h3 class="text-3xl font-bold text-[#25253b] mb-3">Send a Message</h3>
          <p class="text-[#6f6f84] max-w-xl leading-relaxed">
            Tell us about your project, question, or support request and our team will get back to you promptly.
          </p>
        </div>

        <form
          class="space-y-4"
          method="POST"
          action="https://formsubmit.co/bonebreaker712003@gmail.com"
        >
          <!-- <input
            type="hidden"
            name="access_key"
            value="f9cbc9e2-78f8-40ba-8369-ef02a39f6897"
          /> -->

          <input
            type="text"
            placeholder="Your name"
            name="name"
            class="w-full h-14 px-4 rounded-lg bg-[#f7f7f7] border border-[#ececec] outline-none focus:border-[#ff6b1a] transition"
            required
          />

          <input
            type="email"
            name="email"
            placeholder="Your email address"
            class="w-full h-14 px-4 rounded-lg bg-[#f7f7f7] border border-[#ececec] outline-none focus:border-[#ff6b1a] transition"
            required
          />

          <input
            type="text"
            name="number"
            placeholder="Your mobile number"
            class="w-full h-14 px-4 rounded-lg bg-[#f7f7f7] border border-[#ececec] outline-none focus:border-[#ff6b1a] transition"
            required
          />

          <textarea
            rows="6"
            name="message"
            placeholder="Write your message..."
            class="w-full p-4 rounded-lg bg-[#f7f7f7] border border-[#ececec] outline-none focus:border-[#ff6b1a] transition resize-none"
            required
          ></textarea>

          <button
            type="submit"
            class="cta-btn inline-flex items-center justify-center w-full gap-3 bg-orange-500 text-white font-semibold px-5 py-3 md:px-6 md:py-3 rounded-md overflow-hidden"
          >
            Send Message
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  var d = document,
    w = "https://tally.so/widgets/embed.js",
    v = function () {
      if (typeof Tally !== "undefined") {
        Tally.loadEmbeds();
      } else {
        d.querySelectorAll("iframe[data-tally-src]:not([src])").forEach(
          function (e) {
            e.src = e.dataset.tallySrc;
          },
        );
      }
    };

  if (typeof Tally !== "undefined") {
    v();
  } else if (d.querySelector('script[src="' + w + '"]') == null) {
    var s = d.createElement("script");
    s.src = w;
    s.onload = v;
    s.onerror = v;
    d.body.appendChild(s);
  }
</script>
