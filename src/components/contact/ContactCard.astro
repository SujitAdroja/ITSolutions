---
import { Mail, PhoneIncoming } from "lucide-react"
import { contactCards } from "./contactData"
---

<section class="py-12 mb-6 mx-auto">
  <div class="text-center mb-16">
     <span class="inline-flex items-center rounded-full bg-[#fff4ec] px-4 py-2 text-sm font-semibold tracking-[0.18em] uppercase text-[#ff6b1a] mb-5">
Start the Conversation
        </span>
    <h2 class="text-4xl font-bold text-[#232323] reveal">
      Get in Touch With Our Team
    </h2>

    <p class="mt-5 text-[#6d6d6d] max-w-3xl mx-auto leading-relaxed reveal">
      Reach out for project enquiries, service support, partnerships, or general information. Share your requirements and our team will respond with the most relevant next step.
    </p>
  </div>
