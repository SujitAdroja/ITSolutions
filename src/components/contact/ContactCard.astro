---
import { Mail, PhoneIncoming } from "lucide-react"
import { contactCards } from "./contactData"
---


<section class="py-12 mb-6 mx-auto">

    <div class="text-center mb-16">

      <h2 class="text-4xl font-bold text-[#232323] reveal">
        Ready to Get Started?
      </h2>

      <p class="mt-5 text-[#6d6d6d] max-w-3xl mx-auto leading-relaxed reveal">
        Our mostly staffs are working remotely so please e-mail us
        or call us or fill out the form below and we will get back
        to you promptly regarding your request.
      </p>

    </div>

    <div class="grid md:grid-cols-3 gap-8">

      {
        contactCards.map((item) => (
          <div
            class="bg-white border border-[#ececec] p-4 md:p-8 flex flex-col md:flex-row md:items-center gap-2 md:gap-6 reveal"
          >
            <div
              class="flex md:items-center md:justify-center "
            >
              <!-- Icon -->
                {item.title!=="Call Us" && <Mail className="w-8 h-8 text-[#ff6b1a]"
      strokeWidth={2}/>}
              {item.title==="Call Us" && <PhoneIncoming className="w-8 h-8 text-[#ff6b1a]"
      strokeWidth={2}/>}
            </div>

            <div>
              <h3 class="font-bold text-xl mb-2 ">
                {item.title}
              </h3>

              <p class="text-[#6d6d6d]">
                {item.value}
              </p>
            </div>
          </div>
        ))
      }

    </div>


</section>