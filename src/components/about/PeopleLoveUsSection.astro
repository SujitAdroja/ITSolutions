---
export const reasons = [
  {
    number: "1",
    title: "We transform ideas",
    description: "We appreciate the ideas that pave the path to a new horizon. And it turns out to be outstanding when we add to it our intuitive inputs to make your ideas with longer expectancy.",
  },
  {
    number: "2",
    title: "We build relations",
    description: "We stay on board always to assist you even for a minute detail. This is why we don't need to stress building relations, they just happen to be a long lasting bond of ethical business relations.",
  },
  {
    number: "3",
    title: "We long for the best",
    description: "The best achievement for us is to bring a curve of a smile on the face of our clients and eyes with a question about what best else we have to add to their project.",
  },
];
---

<section class="section bg-bg-alt">
  <div class="container-x">

    <div class="reveal mx-auto mb-10 max-w-2xl text-center md:mb-12">
      <span class="eyebrow">People Love Us</span>
      <h2 class="h-section mt-4">What Sets <span class="text-gradient">Us Apart</span></h2>
      <p class="lead mt-4">One solution for all types of fully customised software services.</p>
    </div>

    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">

      <div class="flex flex-col gap-4">
        {reasons.map((item) => (
          <article class="reveal-left card card-hover flex gap-4 p-5 sm:gap-5 sm:p-6">
            <div class="icon-tile-solid !rounded-full text-base font-bold">{item.number}</div>
            <div>
              <h3 class="text-lg font-semibold text-fg">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{item.description}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="reveal-right relative order-first lg:order-last">
        <div aria-hidden="true" class="absolute -inset-4 -z-10 rounded-[2.5rem] bg-brand/10 blur-2xl"></div>
        <img
          src="/about/people-love-us.png"
          alt="Happy clients"
          class="w-full rounded-3xl border border-line object-cover shadow-card"
          loading="lazy"
        />
      </div>

    </div>
  </div>
</section>
