---
const stats = [
  { value: '20+', label: 'Technologies' },
  { value: '50+', label: 'Staff Augmentation Developers Delivered' },
  { value: '100%', label: 'Satisfaction Rate' },
];
---

<section class="bg-bg pb-16 md:pb-20">
  <div class="container-x">
    <div class="banner-navy p-8 md:p-12">
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-3">
        {stats.map((stat) => (
          <div class="reveal flex flex-col gap-1">
            <p class="text-4xl font-extrabold leading-none tracking-tight text-white md:text-5xl">{stat.value}</p>
            <p class="mt-2 text-sm font-medium text-sky-200/80">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
