---
const stats = [
  { value: '20+', label: 'Technologies' },
  { value: '50+', label: 'Staff Augmentation Developers Delivered' },
  { value: '99.9%', label: 'Satisfaction Rate' },
];

const columns = [
  { title: 'Our Team', body: 'Our team brings together specialists in accounting, marketing, design, and software development to support a wide range of business needs.' },
  { title: 'Our Story', body: 'We have grown by delivering practical solutions that help clients stay organised, improve their presence, and move projects forward with confidence.' },
  { title: 'Who We Are', body: 'EchoEleganceLtd.uk is a service-focused company helping businesses improve operations, strengthen digital presence, and deliver better customer experiences.' },
];
---

<section class="section bg-bg">
  <div class="container-x">

    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">

      <div class="reveal-left relative">
        <div aria-hidden="true" class="absolute -inset-4 -z-10 rounded-[2.5rem] bg-brand/10 blur-2xl"></div>
        <img
          src="/about/hero-image.png"
          alt="The EchoElegance team at work"
          class="w-full rounded-3xl border border-line object-cover shadow-card"
          loading="lazy"
        />
      </div>

      <div class="reveal-right">
        <span class="eyebrow">About Us</span>
        <h2 class="h-section mt-4">
          Driving Business Growth Through <span class="text-gradient">Practical Digital Solutions</span>
        </h2>
        <p class="mt-5 text-[15px] leading-relaxed text-muted">
          EchoEleganceLtd.uk provides professional services across accounting, digital marketing, web development, web designing, graphics designing, analytical reporting, service administration, QA &amp; QC, and custom development. We help businesses improve visibility, streamline operations, and build dependable digital systems.
        </p>

        <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-3 sm:gap-4">
          {stats.map((stat) => (
            <div class="rounded-2xl border border-line bg-bg-alt p-5">
              <p class="text-gradient text-3xl font-extrabold leading-none tracking-tight">{stat.value}</p>
              <p class="mt-2 text-xs font-medium text-muted sm:text-sm">{stat.label}</p>
            </div>
          ))}
        </div>

        <p class="mt-7 text-[15px] leading-relaxed text-muted">
          We combine strategic thinking with practical delivery to support clients from planning and execution through to reporting, optimisation, and long-term support.
        </p>
      </div>
    </div>

    <div class="reveal mt-14 grid gap-5 md:mt-16 md:grid-cols-3">
      {columns.map((col) => (
        <article class="card card-hover p-7">
          <h3 class="text-xl font-semibold text-fg">{col.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">{col.body}</p>
        </article>
      ))}
    </div>

  </div>
</section>
