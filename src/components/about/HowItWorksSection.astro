---
export const processSteps = [
  { id: "01", title: "Frame the Problem", image: "/about/hiw-card-image.png" },
  { id: "02", title: "Analysis and Review", image: "/about/hiw-card-image.png" },
  { id: "03", title: "Collect the Raw Data", image: "/about/hiw-card-image.png" },
  { id: "04", title: "Explore the Data", image: "/about/hiw-card-image.png" },
  { id: "05", title: "Perform Update", image: "/about/hiw-card-image.png" },
  { id: "06", title: "Communicate Results", image: "/about/hiw-card-image.png" },
];
---

<section class="section bg-bg">
  <div class="container-x">

    <div class="reveal mx-auto mb-10 max-w-2xl text-center md:mb-12">
      <span class="eyebrow">How It Works</span>
      <h2 class="h-section mt-4">Our Process For <span class="text-gradient">Custom Software</span></h2>
    </div>

    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">

      <div class="reveal-left relative">
        <div aria-hidden="true" class="absolute -inset-4 -z-10 rounded-[2.5rem] bg-brand/10 blur-2xl"></div>
        <img
          src="/about/how-it-work.png"
          alt="Our delivery process"
          class="w-full rounded-3xl border border-line object-cover shadow-card"
          loading="lazy"
        />
      </div>

      <ol class="flex flex-col gap-3">
        {processSteps.map((step) => (
          <li class="reveal-right card card-hover flex items-center gap-4 px-5 py-4">
            <div class="icon-tile">
              <img src={step.image} alt="" class="size-7 object-contain" loading="lazy" />
            </div>
            <span class="flex-1 text-[15px] font-semibold text-fg sm:text-base">{step.title}</span>
            <span class="text-gradient text-2xl font-extrabold leading-none opacity-70">{step.id}</span>
          </li>
        ))}
      </ol>

    </div>
  </div>
</section>
